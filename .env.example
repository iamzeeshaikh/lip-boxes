# ---------------------------------------------------------------------------
# SMTP delivery for the quote forms.
#
# Copy this file to `.env` for local development and set the real values there.
# In production, set the same variables in the Vercel project's Environment
# Variables panel. Never commit `.env` and never prefix any of these with
# PUBLIC_ — that would expose them to the browser.
# ---------------------------------------------------------------------------

SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_TO=
SMTP_FROM_NAME=
SMTP_FROM_EMAIL=
