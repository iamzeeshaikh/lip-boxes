---
import { Image } from 'astro:assets';
import type { Product } from '../data/types';
import { productImage } from '../lib/images';
import Icon from './Icon.astro';

interface Props {
  product: Product;
  /** Set true for cards above the fold so the image is not lazy-loaded. */
  eager?: boolean;
  /** Compact variant used in the related-products strip. */
  compact?: boolean;
}

const { product, eager = false, compact = false } = Astro.props;
const hero = product.images[0];
const img = productImage(product.slug, hero.file);
const href = `/${product.slug}/`;
---

<article class:list={['vx-card', compact && 'vx-card--compact']}>
  <a class="vx-card__media" href={href} tabindex="-1" aria-hidden="true">
    <Image
      src={img}
      alt={hero.alt || product.name}
      widths={[320, 480, 640]}
      sizes={compact
        ? '(min-width: 62rem) 22vw, (min-width: 40rem) 44vw, 88vw'
        : '(min-width: 76rem) 17rem, (min-width: 40rem) 44vw, 88vw'}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      decoding={eager ? 'sync' : 'async'}
      class="vx-card__img"
      width={480}
      height={480}
    />
  </a>
  <div class="vx-card__body">
    <h3 class="vx-card__title">
      <a href={href}>{product.name}</a>
    </h3>
    {!compact && <p class="vx-card__desc">{product.cardDescription}</p>}
    <p class="vx-card__meta">
      <span class="vx-card__cta">
        View specification
        <Icon name="arrow-right" size={15} />
      </span>
    </p>
  </div>
</article>

<style>
  .vx-card {
    position: relative;
    display: flex;
    flex-direction: column;
  }
  .vx-card__media {
    display: block;
    background: var(--vx-grey);
    aspect-ratio: 1 / 1;
    overflow: hidden;
    margin-bottom: 12px;
  }
  .vx-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.2s;
  }
  .vx-card:hover .vx-card__img {
    opacity: 0.88;
  }
  .vx-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .vx-card__title {
    font-size: 1.4rem;
    margin: 0 0 6px;
    line-height: 1.1;
  }
  .vx-card__title a {
    display: inline-block;
    min-height: 1.5rem;
    color: var(--vx-ink);
    text-decoration: none;
  }
  /* The title link covers the card, so the whole card is one target. */
  .vx-card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .vx-card:hover .vx-card__title a {
    color: var(--vx-accent);
  }
  .vx-card__desc {
    font-size: 0.9rem;
    color: #444;
    line-height: 1.5;
    margin: 0 0 10px;
  }
  .vx-card__meta {
    margin: auto 0 0;
  }
  .vx-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--vx-ink);
    border-bottom: 1px solid var(--vx-accent);
  }
  .vx-card--compact .vx-card__title {
    font-size: 1.2rem;
  }
</style>
