---
import Breadcrumbs from './Breadcrumbs.astro';
import type { Crumb } from '../lib/schema';

interface Props {
  h1: string;
  lead?: string;
  crumbs: Crumb[];
  /** Optional supporting points shown as a short ruled row under the lead. */
  points?: string[];
}

const { h1, lead, crumbs, points } = Astro.props;
---

<div class="vx-mast">
  <Breadcrumbs crumbs={crumbs} />
  <div class="vx-mast__body">
    <h1>{h1}</h1>
    {lead && <p class="vx-lede vx-mast__lead">{lead}</p>}
  </div>
  {
    points && points.length > 0 && (
      <ul class="vx-mast__points">
        {points.map((point) => <li>{point}</li>)}
      </ul>
    )
  }
</div>

<style>
  .vx-mast {
    padding: 22px var(--gut) 40px;
    max-width: var(--wrap);
    margin-inline: auto;
    width: 100%;
  }
  .vx-mast__body {
    display: grid;
    gap: 18px 20px;
    align-items: end;
    margin-top: 26px;
    padding-bottom: 26px;
    border-bottom: 1px solid var(--vx-rule);
  }
  .vx-mast h1 {
    margin: 0;
    font-size: clamp(2.6rem, 1.6rem + 3.4vw, 5.2rem);
    max-width: 20ch;
  }
  .vx-mast__lead {
    margin: 0;
    max-width: 58ch;
  }
  @media (min-width: 62rem) {
    .vx-mast__body {
      grid-template-columns: 7fr 5fr;
    }
  }
  .vx-mast__points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
    gap: 0 20px;
  }
  .vx-mast__points li {
    padding: 12px 0;
    border-bottom: 1px solid var(--vx-rule-lt);
    font-size: 0.94rem;
    color: var(--vx-ink-2);
  }
  .vx-mast__points li::before {
    content: '';
    display: inline-block;
    width: 10px;
    height: 2px;
    margin: 0 10px 4px 0;
    background: var(--vx-accent);
  }
  @media (max-width: 860px) {
    .vx-mast {
      padding-bottom: 28px;
    }
    .vx-mast h1 {
      font-size: 2.6rem;
    }
  }
</style>
