---
import { site } from '../data/site';
import Icon from './Icon.astro';

interface Props {
  heading?: string;
  body?: string;
  /** Product name pre-filled into the quote form when arriving from a product page. */
  product?: string;
  /** Second button target. Defaults to the sample kit page. */
  secondaryHref?: string;
  secondaryLabel?: string;
}

const {
  heading = 'Tell us what you need packaged',
  body = 'Send your dimensions, quantity and artwork status. You will get a written quote with the price at your quantity and at the next volume break.',
  product,
  secondaryHref,
  secondaryLabel,
} = Astro.props;

const ctaSecondaryHref = secondaryHref ?? '/sample-kit/';
const ctaSecondaryLabel = secondaryLabel ?? 'See sample options';

const quoteHref = product
  ? `/request-a-quote/?product=${encodeURIComponent(product)}`
  : '/request-a-quote/';
---

<section class="vx-close">
  <h2>{heading}</h2>
  <div class="vx-close__side">
    <p>{body}</p>
    <p class="vx-close__price">{site.startingPriceStatement}</p>
    <div class="vx-btns">
      <a href={quoteHref} class="vx-btn vx-btn--red">
        Request a Quote
        <Icon name="arrow-right" size={18} />
      </a>
      <a href={ctaSecondaryHref} class="vx-arrow">{ctaSecondaryLabel}</a>
    </div>
    <p class="vx-close__contact">
      Or email <a href={`mailto:${site.email}`}>{site.email}</a>
      {site.phone && <> or call <a href={`tel:${site.phone}`}>{site.phoneDisplay ?? site.phone}</a></>}
    </p>
  </div>
</section>

<style>
  .vx-close {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 24px 20px;
    align-items: end;
    max-width: var(--wrap);
    width: calc(100% - 2 * var(--gut));
    margin: 0 auto;
    padding: 72px 0 88px;
    border-top: 1px solid var(--vx-rule);
  }
  .vx-close h2 {
    grid-column: 1 / 8;
    margin: 0;
    font-size: clamp(2.4rem, 1.5rem + 3vw, 4.5rem);
    line-height: 0.95;
    text-transform: uppercase;
  }
  .vx-close__side {
    grid-column: 8 / 13;
  }
  .vx-close__side p {
    color: var(--vx-ink-2);
    max-width: 52ch;
  }
  .vx-close__price {
    font-size: 0.94rem;
    padding-top: 12px;
    margin-top: 12px;
    border-top: 1px solid var(--vx-rule-lt);
  }
  .vx-close .vx-btns {
    margin: 20px 0 14px;
  }
  .vx-close__contact {
    font-size: 0.94rem;
  }
  @media (max-width: 860px) {
    .vx-close {
      grid-template-columns: 1fr;
      padding: 52px 0 64px;
    }
    .vx-close h2,
    .vx-close__side {
      grid-column: 1 / -1;
    }
    .vx-close h2 {
      font-size: 2.5rem;
    }
  }
</style>
