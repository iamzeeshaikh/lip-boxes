---
import { Image, Picture } from 'astro:assets';
import type { ProductImage } from '../data/types';
import { productImage } from '../lib/images';

interface Props {
  slug: string;
  images: ProductImage[];
  /** Used for the aria label on the thumbnail list. */
  productName: string;
}

const { slug, images, productName } = Astro.props;
const resolved = images.map((image) => ({
  ...image,
  asset: productImage(slug, image.file),
}));
const [lead, ...rest] = resolved;
const captions = resolved.map((image) => image.caption ?? image.alt);
---

<div class="vx-gal" data-gallery data-captions={JSON.stringify(captions)}>
  <figure class="vx-gal__stage">
    {
      resolved.map((image, i) => (
        <div class="vx-gal__panel" data-panel={i} hidden={i !== 0}>
          <Picture
            src={image.asset}
            alt={image.alt}
            formats={['avif']}
            fallbackFormat="webp"
            widths={[420, 620, 840]}
            sizes="(min-width: 62rem) 46vw, 92vw"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'auto'}
            decoding={i === 0 ? 'sync' : 'async'}
            width={840}
            height={840}
            class="vx-gal__img"
          />
        </div>
      ))
    }
    <figcaption class="vx-gal__caption" data-caption>{lead.caption ?? lead.alt}</figcaption>
  </figure>

  {
    rest.length > 0 && (
      <ul class="vx-gal__thumbs" aria-label={`${productName} photographs`}>
        {resolved.map((image, i) => (
          <li>
            <button
              type="button"
              class="vx-gal__thumb"
              data-thumb={i}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              <Image
                src={image.asset}
                alt={`View: ${image.alt}`}
                widths={[120, 200]}
                sizes="5rem"
                loading="lazy"
                decoding="async"
                width={200}
                height={200}
              />
            </button>
          </li>
        ))}
      </ul>
    )
  }
</div>

<style>
  .vx-gal {
    display: grid;
    gap: 12px;
  }
  .vx-gal__stage {
    margin: 0;
  }
  .vx-gal__panel {
    background: var(--vx-grey);
    overflow: hidden;
  }
  .vx-gal__panel[hidden] {
    display: none;
  }
  .vx-gal__img {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }
  .vx-gal__caption {
    margin-top: 8px;
    padding-top: 6px;
    border-top: 1px solid var(--vx-rule-lt);
    font-size: 12.5px;
    color: var(--vx-mute-c);
    line-height: 1.45;
    min-height: 2.6em;
  }
  .vx-gal__thumbs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 10px;
  }
  .vx-gal__thumb {
    display: block;
    padding: 0;
    width: 100%;
    background: var(--vx-grey);
    border: 0;
    outline: 1px solid var(--vx-rule-lt);
    cursor: pointer;
    transition: outline-color 0.15s, opacity 0.15s;
    opacity: 0.8;
  }
  .vx-gal__thumb:hover {
    opacity: 1;
  }
  .vx-gal__thumb[aria-pressed='true'] {
    outline: 2px solid var(--vx-accent);
    opacity: 1;
  }
  .vx-gal__thumb img {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }
  @media (max-width: 40rem) {
    .vx-gal__thumbs {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 8px;
    }
  }
</style>

<script>
  for (const gallery of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
    const panels = Array.from(gallery.querySelectorAll<HTMLElement>('[data-panel]'));
    const thumbs = Array.from(gallery.querySelectorAll<HTMLButtonElement>('[data-thumb]'));
    const caption = gallery.querySelector<HTMLElement>('[data-caption]');
    if (thumbs.length < 2) continue;

    // Captions are authored per image in the product data and serialized into
    // the markup, so the client script never generates its own text.
    let captions: string[] = [];
    try {
      captions = JSON.parse(gallery.dataset.captions ?? '[]');
    } catch {
      captions = [];
    }

    /*
     * Hidden panels have `display: none`, so their lazy-loaded images never
     * intersect the viewport and would only start downloading on the first
     * click. Warming flips them to eager (at low fetch priority) once the
     * page is idle — and immediately on pointer intent — so every swap is
     * instant.
     */
    const warmed = new Set<number>();
    function warm(index: number) {
      if (warmed.has(index)) return;
      warmed.add(index);
      const panel = panels[index];
      if (!panel) return;
      for (const img of panel.querySelectorAll('img')) {
        if (img.loading !== 'lazy') continue;
        img.fetchPriority = 'low';
        img.loading = 'eager';
      }
    }
    function warmAll() {
      panels.forEach((_, i) => warm(i));
    }

    function show(index: number) {
      warm(index);
      panels.forEach((panel, i) => {
        panel.hidden = i !== index;
      });
      thumbs.forEach((thumb, i) => {
        thumb.setAttribute('aria-pressed', String(i === index));
      });
      if (caption && captions[index]) caption.textContent = captions[index];
    }

    thumbs.forEach((thumb, i) => {
      thumb.addEventListener('click', () => show(i));
      thumb.addEventListener('pointerenter', () => warm(i));
      thumb.addEventListener('touchstart', () => warm(i), { passive: true });
    });

    if ('requestIdleCallback' in window) {
      requestIdleCallback(warmAll, { timeout: 3000 });
    } else if (document.readyState === 'complete') {
      setTimeout(warmAll, 300);
    } else {
      (window as Window).addEventListener('load', () => setTimeout(warmAll, 300), { once: true });
    }
  }
</script>
