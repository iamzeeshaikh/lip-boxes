---
import type { Faq } from '../data/types';

interface Props {
  faqs: Faq[];
  heading?: string;
  intro?: string;
  /** Heading level for each question. */
  level?: 2 | 3;
  id?: string;
  /** Heading in a left column, questions on the right (wide screens only). */
  split?: boolean;
}

const { faqs, heading, intro, level = 3, id, split = false } = Astro.props;
const QTag = `h${level}` as 'h2' | 'h3';
---

<div class:list={['vx-faqs', split && 'vx-faqs--split']} id={id}>
  {(heading || intro) && (
    <div class="vx-faqs__side">
      {heading && <h2 class="vx-faqs__heading">{heading}</h2>}
      {intro && <p class="vx-faqs__intro vx-measure">{intro}</p>}
    </div>
  )}
  <div class="vx-faqs__list">
    {
      faqs.map((faq, i) => (
        <details class="vx-qa" open={i === 0}>
          <summary class="vx-qa__summary">
            <QTag class="vx-qa__q">{faq.q}</QTag>
            <span class="vx-qa__icon" aria-hidden="true">
              <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round">
                <path d="M3 8h10" /><path class="vx-qa__icon-v" d="M8 3v10" />
              </svg>
            </span>
          </summary>
          <div class="vx-qa__a"><p set:html={faq.a} /></div>
        </details>
      ))
    }
  </div>
</div>

<style>
  @media (min-width: 62rem) {
    .vx-faqs--split {
      display: grid;
      grid-template-columns: 4fr 7fr;
      gap: 20px 6%;
      align-items: start;
    }
    .vx-faqs--split .vx-faqs__side {
      position: sticky;
      top: 100px;
    }
  }
  .vx-faqs--split .vx-faqs__heading {
    font-size: clamp(2rem, 1.4rem + 2vw, 3.4rem);
  }
  .vx-faqs__heading {
    margin-bottom: var(--sp-3);
  }
  .vx-faqs__intro {
    margin-bottom: var(--sp-5);
    color: var(--vx-ink-2);
  }
  .vx-faqs__list {
    border-top: 1px solid var(--vx-rule);
  }
  .vx-qa {
    border-bottom: 1px solid var(--vx-rule);
  }
  .vx-qa__summary {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    padding: 20px 0;
    cursor: pointer;
    list-style: none;
  }
  .vx-qa__summary::-webkit-details-marker {
    display: none;
  }
  .vx-qa__summary:hover .vx-qa__q {
    color: var(--vx-accent);
  }
  .vx-qa__q {
    font: 500 1.3rem/1.25 var(--vx-head);
    margin: 0;
    color: var(--vx-ink);
    transition: color 0.15s;
  }
  .vx-qa__icon {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    color: var(--vx-accent);
  }
  .vx-qa__icon svg {
    width: 22px;
    height: 22px;
  }
  .vx-qa[open] .vx-qa__icon-v {
    display: none;
  }
  .vx-qa__a {
    padding: 0 48px 22px 0;
    max-width: 78ch;
    color: var(--vx-ink-2);
  }
  .vx-qa__a p {
    margin: 0;
  }
  .vx-qa__summary:focus-visible {
    outline: 2px solid var(--vx-accent);
    outline-offset: 2px;
  }
  @media (max-width: 860px) {
    .vx-qa__q {
      font-size: 1.15rem;
    }
    .vx-qa__summary {
      padding: 16px 0;
    }
    .vx-qa__a {
      padding-right: 0;
    }
  }
</style>
