---
import { Image } from 'astro:assets';
import { primaryNav } from '../data/nav';
import { site } from '../data/site';
import { products } from '../data/products';
import { productImage } from '../lib/images';
import Icon from './Icon.astro';
import LogoMark from './LogoMark.astro';

const path = Astro.url.pathname;
const isCurrent = (href?: string) =>
  Boolean(href) && (href === '/' ? path === '/' : path.startsWith(href!));

/*
 * Thumbnails for the products mega menu, resolved from the product data so a
 * new product picks one up automatically.
 */
const thumbnails = new Map<string, ImageMetadata>(
  products.map((product) => [
    `/${product.slug}/`,
    productImage(product.slug, product.images[0].file),
  ]),
);
thumbnails.set(
  '/lip-balm-packaging/',
  productImage('lip-balm-packaging', 'lip-balm-packaging-foil-stamped-carton.png'),
);
const groupOf = new Map(products.map((p) => [`/${p.slug}/`, p.group]));

/* Products are shown in three columns: balm, lipstick, then gloss and care. */
const productItem = primaryNav.find((item) => item.href === '/products/');
const megaColumns = [
  { title: 'Lip Balm', groups: ['Lip Balm'] },
  { title: 'Lipstick', groups: ['Lipstick'] },
  { title: 'Lip Gloss & Lip Care', groups: ['Lip Gloss', 'Lip Care'] },
].map((col) => ({
  ...col,
  links: (productItem?.children ?? []).filter((c) =>
    col.groups.includes(groupOf.get(c.href) ?? ''),
  ),
}));
const featureImage = productImage('lipstick-boxes', 'lipstick-boxes-nude-collection.png');

const waHref = site.whatsapp
  ? `https://wa.me/${site.whatsapp.replace(/[^0-9]/g, '')}?text=${encodeURIComponent('Hi Lip Boxes! I need more info about Lip Boxes https://lipboxes.com/')}`
  : null;
---

<div class="vx-strap">
  <span class="vx-strap__left">{site.tagline}. Free shipping to the US, UK, Canada and Australia.</span>
  <span class="vx-strap__right">
    {
      site.phone && (
        <>
          <a href={`tel:${site.phone}`}>{site.phoneDisplay ?? site.phone}</a>
          <span aria-hidden="true">/</span>
        </>
      )
    }
    <a href={`mailto:${site.email}`}>{site.email}</a>
    {
      waHref && (
        <>
          <span aria-hidden="true">/</span>
          <a href={waHref} target="_blank" rel="noopener noreferrer">WhatsApp</a>
        </>
      )
    }
  </span>
</div>

<header class="vx-head">
  <a href="/" class="vx-logo" aria-label="Lip Boxes home">
    <LogoMark class="vx-logo__mark" />
    <span class="vx-logo__name">Lip Boxes</span>
  </a>

  <button
    type="button"
    class="vx-burger"
    aria-expanded="false"
    aria-controls="primary-nav"
    data-nav-toggle
  >
    <span class="vx-burger__open"><Icon name="menu" size={22} /></span>
    <span class="vx-burger__close"><Icon name="close" size={22} /></span>
    <span class="visually-hidden">Menu</span>
  </button>

  <nav id="primary-nav" class="vx-nav" aria-label="Primary">
    <ul class="vx-nav__list">
      {
        primaryNav.map((item) =>
          item.children ? (
            <li
              class:list={[
                'vx-nav__item',
                'vx-nav__item--drop',
                item.href === '/products/' && 'vx-nav__item--mega',
              ]}
            >
              <button
                type="button"
                class="vx-nav__top"
                aria-expanded="false"
                data-submenu-toggle
              >
                {item.label}
                <Icon name="chevron-down" size={14} class="vx-nav__chev" />
              </button>
              {item.href === '/products/' ? (
                <div class="vx-drop vx-drop--mega">
                  <div class="vx-mega">
                    {megaColumns.map((col) => (
                      <div class="vx-mega__col">
                        <p class="vx-mega__group">{col.title}</p>
                        <ul>
                          {col.links.map((child) => {
                            const thumb = thumbnails.get(child.href);
                            return (
                              <li>
                                <a
                                  href={child.href}
                                  aria-current={path === child.href ? 'page' : undefined}
                                >
                                  {thumb && (
                                    <Image
                                      src={thumb}
                                      alt={child.label}
                                      widths={[96, 144]}
                                      sizes="48px"
                                      loading="lazy"
                                      decoding="async"
                                      width={144}
                                      height={144}
                                    />
                                  )}
                                  <span>
                                    <span class="vx-mega__label">{child.label}</span>
                                    {child.note && <span class="vx-mega__note">{child.note}</span>}
                                  </span>
                                </a>
                              </li>
                            );
                          })}
                        </ul>
                      </div>
                    ))}
                    <a class="vx-mega__feature" href={item.href}>
                      <Image
                        src={featureImage}
                        alt="Printed nude lipstick boxes with matching cases"
                        widths={[280, 560]}
                        sizes="280px"
                        loading="lazy"
                        decoding="async"
                        width={560}
                        height={560}
                      />
                      <span>See the full product directory</span>
                    </a>
                  </div>
                </div>
              ) : (
                <div class="vx-drop">
                  <ul>
                    {item.children.map((child) => (
                      <li>
                        <a
                          href={child.href}
                          aria-current={path === child.href ? 'page' : undefined}
                        >
                          {child.label}
                          {child.note && <small>{child.note}</small>}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </li>
          ) : (
            <li class="vx-nav__item">
              <a
                href={item.href}
                class="vx-nav__top"
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ),
        )
      }
    </ul>

    <div class="vx-head__actions">
      {
        site.phone && (
          <a href={`tel:${site.phone}`} class="vx-head__tel">
            {site.phoneDisplay ?? site.phone}
          </a>
        )
      }
      <a href="/request-a-quote/" class="vx-btn vx-btn--red vx-head__cta">Request a Quote</a>
    </div>
  </nav>
</header>

<style>
  .vx-strap {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding: 4px var(--gut);
    background: var(--vx-ink);
    color: #e9e9e9;
    font-size: 13px;
    line-height: 1.4;
  }

  .vx-strap a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    color: #e9e9e9;
    text-decoration: none;
  }
  .vx-strap a:hover {
    color: #fff;
    text-decoration: underline;
  }
  .vx-strap__right {
    display: flex;
    gap: 10px;
    white-space: nowrap;
  }

  .vx-head {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    gap: 28px;
    padding: 0 var(--gut);
    height: 76px;
    background: var(--vx-white);
    border-bottom: 1px solid var(--vx-rule);
  }
  .vx-logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--vx-ink);
    flex: none;
  }
  .vx-logo:hover {
    color: var(--vx-ink);
  }
  .vx-logo :global(.vx-logo__mark) {
    width: 38px;
    height: 38px;
  }
  .vx-logo__name {
    font: 600 28px/1 var(--vx-head);
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .vx-burger {
    display: none;
  }
  .vx-nav {
    display: flex;
    align-items: center;
    flex: 1;
    height: 100%;
  }
  .vx-nav__list {
    display: flex;
    list-style: none;
    margin: 0 auto;
    padding: 0;
    height: 100%;
  }
  .vx-nav__item {
    display: flex;
    align-items: stretch;
    height: 100%;
    position: relative;
  }
  .vx-nav__item--mega {
    position: static;
  }
  .vx-nav__top {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 0 14px;
    font: 600 15px/1 var(--vx-body);
    color: var(--vx-ink);
    text-decoration: none;
    background: none;
    border: 0;
    border-top: 3px solid transparent;
    border-bottom: 3px solid transparent;
    cursor: pointer;
    white-space: nowrap;
  }
  .vx-nav__item:hover > .vx-nav__top,
  .vx-nav__top[aria-expanded='true'],
  .vx-nav__top[aria-current='page'] {
    border-bottom-color: var(--vx-accent);
    color: var(--vx-ink);
  }
  .vx-nav__top :global(.vx-nav__chev) {
    transition: transform 0.18s;
  }
  .vx-nav__top[aria-expanded='true'] :global(.vx-nav__chev) {
    transform: rotate(180deg);
  }

  .vx-drop {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 260px;
    padding: 10px 0;
    background: var(--vx-white);
    border: 1px solid var(--vx-rule);
    display: none;
  }
  .vx-drop::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: -14px;
    height: 14px;
  }
  .vx-nav__top[aria-expanded='true'] + .vx-drop {
    display: block;
  }
  .vx-nav__item:last-of-type .vx-drop {
    left: auto;
    right: 0;
  }
  .vx-drop ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .vx-drop:not(.vx-drop--mega) a {
    display: block;
    padding: 8px 20px;
    font-size: 15px;
    color: var(--vx-ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .vx-drop:not(.vx-drop--mega) a small {
    display: block;
    color: var(--vx-mute-c);
    font-size: 13px;
  }
  .vx-drop:not(.vx-drop--mega) a:hover,
  .vx-drop a[aria-current='page'] {
    background: var(--vx-grey);
    color: var(--vx-accent);
  }

  .vx-drop--mega {
    left: 0;
    right: 0;
    padding: 28px var(--gut) 32px;
    border-width: 0 0 1px;
  }
  .vx-mega {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 260px;
    gap: 32px;
  }
  .vx-mega__group {
    font: 500 20px/1 var(--vx-head);
    padding-bottom: 10px;
    margin: 0 0 8px;
    border-bottom: 1px solid var(--vx-rule);
  }
  .vx-mega__col a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 6px 0;
    font-size: 15px;
    line-height: 1.25;
    color: var(--vx-ink);
    text-decoration: none;
  }
  .vx-mega__col a :global(img) {
    width: 48px;
    height: 48px;
    object-fit: cover;
    flex: none;
    background: var(--vx-grey);
  }
  .vx-mega__label {
    display: block;
    font-weight: 500;
  }
  .vx-mega__note {
    display: block;
    font-size: 13px;
    color: var(--vx-mute-c);
  }
  .vx-mega__col a:hover .vx-mega__label,
  .vx-mega__col a[aria-current='page'] .vx-mega__label {
    color: var(--vx-accent);
  }
  .vx-mega__feature {
    text-decoration: none;
    font-weight: 600;
    color: var(--vx-ink);
  }
  .vx-mega__feature :global(img) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    margin-bottom: 10px;
  }
  .vx-mega__feature span::after {
    content: ' \2192';
  }
  .vx-mega__feature:hover span {
    color: var(--vx-accent);
  }

  .vx-head__actions {
    display: flex;
    align-items: center;
    gap: 18px;
    flex: none;
  }
  .vx-head__tel {
    font-weight: 600;
    text-decoration: none;
  }
  /* The number is always in the top strap; beside the menu only where the full
     desktop row has room for it without touching the last menu item. */
  @media (max-width: 1439px) {
    .vx-head__tel {
      display: none;
    }
  }

  /* ---------- Narrow desktop: tighten before the drawer takes over ---------- */
  @media (min-width: 1181px) and (max-width: 1340px) {
    .vx-head {
      gap: 18px;
    }
    .vx-nav__top {
      padding: 0 9px;
      font-size: 14px;
    }
    .vx-head__cta {
      padding: 0 16px;
    }
  }

  /* ---------- Drawer ---------- */
  @media (max-width: 1180px) {
    .vx-burger {
      display: grid;
      place-items: center;
      margin-left: auto;
      width: 48px;
      height: 48px;
      background: none;
      border: 1px solid var(--vx-rule);
      color: var(--vx-ink);
      cursor: pointer;
    }
    .vx-burger__close {
      display: none;
    }
    .vx-burger[aria-expanded='true'] .vx-burger__open {
      display: none;
    }
    .vx-burger[aria-expanded='true'] .vx-burger__close {
      display: block;
    }
    .vx-nav {
      position: fixed;
      top: var(--vx-head-bottom, 76px);
      left: 0;
      right: 0;
      bottom: 0;
      display: none;
      flex-direction: column;
      align-items: stretch;
      height: auto;
      padding: 8px var(--gut) 120px;
      background: #fff;
      overflow-y: auto;
      border-top: 1px solid var(--vx-rule);
    }
    .vx-nav[data-open] {
      display: flex;
    }
    .vx-nav__list {
      flex-direction: column;
      margin: 0;
      height: auto;
    }
    .vx-nav__item {
      flex-direction: column;
      height: auto;
      border-bottom: 1px solid var(--vx-rule-lt);
      position: static;
    }
    .vx-nav__top {
      justify-content: space-between;
      width: 100%;
      padding: 16px 0;
      font: 500 22px/1 var(--vx-head);
      border: 0;
      text-align: left;
    }
    .vx-drop,
    .vx-drop--mega {
      position: static;
      border: 0;
      padding: 0 0 14px;
      min-width: 0;
    }
    .vx-drop::before {
      display: none;
    }
    .vx-drop:not(.vx-drop--mega) a {
      padding: 7px 0;
      white-space: normal;
    }
    .vx-mega {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .vx-mega__feature :global(img) {
      display: none;
    }
    .vx-mega__group {
      font-size: 16px;
      border-color: var(--vx-rule-lt);
    }
    .vx-head__actions {
      flex-direction: column;
      align-items: stretch;
      margin-top: 20px;
    }
  }
  @media (max-width: 860px) {
    .vx-strap {
      font-size: 12px;
      padding: 3px var(--gut);
      justify-content: flex-end;
    }
    .vx-strap__left {
      display: none;
    }
    .vx-head {
      height: 64px;
      gap: 12px;
    }
    .vx-logo__name {
      font-size: 24px;
    }
    .vx-logo :global(.vx-logo__mark) {
      width: 32px;
      height: 32px;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.getElementById('primary-nav');
  const head = document.querySelector<HTMLElement>('.vx-head');
  const submenuButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-submenu-toggle]'),
  );
  const DESKTOP = window.matchMedia('(min-width: 1181px)');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    if (head) {
      document.documentElement.style.setProperty(
        '--vx-head-bottom',
        `${Math.max(0, head.getBoundingClientRect().bottom)}px`,
      );
    }
    if (open) {
      nav?.removeAttribute('data-open');
      document.body.style.overflow = '';
    } else {
      nav?.setAttribute('data-open', '');
      document.body.style.overflow = 'hidden';
    }
  });

  function closeAllSubmenus(except?: HTMLButtonElement) {
    for (const b of submenuButtons) {
      if (b !== except) b.setAttribute('aria-expanded', 'false');
    }
  }

  for (const button of submenuButtons) {
    button.addEventListener('click', () => {
      const open = button.getAttribute('aria-expanded') === 'true';
      closeAllSubmenus(button);
      button.setAttribute('aria-expanded', String(!open));
    });

    // On pointer devices at desktop width, hovering the group opens it.
    const item = button.closest('.vx-nav__item--drop');
    let closeTimer: ReturnType<typeof setTimeout> | undefined;

    item?.addEventListener('pointerenter', (event) => {
      if (!DESKTOP.matches || (event as PointerEvent).pointerType === 'touch') return;
      clearTimeout(closeTimer);
      closeAllSubmenus(button);
      button.setAttribute('aria-expanded', 'true');
    });
    item?.addEventListener('pointerleave', () => {
      if (!DESKTOP.matches) return;
      clearTimeout(closeTimer);
      closeTimer = setTimeout(() => {
        button.setAttribute('aria-expanded', 'false');
      }, 300);
    });
  }

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const open = submenuButtons.find((b) => b.getAttribute('aria-expanded') === 'true');
    if (open) {
      open.setAttribute('aria-expanded', 'false');
      open.focus();
    }
  });

  document.addEventListener('click', (event) => {
    if (!DESKTOP.matches) return;
    const target = event.target as Node;
    if (!nav?.contains(target)) closeAllSubmenus();
  });

  nav?.addEventListener('focusout', (event) => {
    if (!DESKTOP.matches) return;
    const related = event.relatedTarget as Node | null;
    for (const button of submenuButtons) {
      const item = button.closest('.vx-nav__item--drop');
      if (item && !item.contains(related)) button.setAttribute('aria-expanded', 'false');
    }
  });
</script>
