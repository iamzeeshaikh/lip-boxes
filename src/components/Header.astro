---
import { primaryNav } from '../data/nav';
import { site } from '../data/site';
import Icon from './Icon.astro';

const path = Astro.url.pathname;
const isCurrent = (href?: string) =>
  Boolean(href) && (href === '/' ? path === '/' : path.startsWith(href!));
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a href="/" class="brand" aria-label="Lip Boxes home">
      <span class="brand__mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" width="30" height="30" fill="none" aria-hidden="true">
          <path d="M4 11.5 16 5l12 6.5v9L16 27 4 20.5v-9Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
          <path d="M4 11.5 16 18l12-6.5M16 18v9" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
          <path d="M11 14.2c1.6-2 3.4-2 5 0 1.6-2 3.4-2 5 0-1.4 2.6-3.3 3.9-5 3.9s-3.6-1.3-5-3.9Z" fill="currentColor" opacity=".85"/>
        </svg>
      </span>
      <span class="brand__name">Lip&nbsp;Boxes</span>
    </a>

    <button
      type="button"
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="primary-nav"
      data-nav-toggle
    >
      <span class="nav-toggle__open"><Icon name="menu" size={22} /></span>
      <span class="nav-toggle__close"><Icon name="close" size={22} /></span>
      <span class="visually-hidden">Menu</span>
    </button>

    <nav id="primary-nav" class="nav" aria-label="Primary">
      <ul class="nav__list">
        {
          primaryNav.map((item) =>
            item.children ? (
              <li class="nav__item nav__item--has-menu">
                <button
                  type="button"
                  class="nav__link nav__link--button"
                  aria-expanded="false"
                  data-submenu-toggle
                >
                  {item.label}
                  <Icon name="chevron-down" size={15} class="nav__chevron" />
                </button>
                <div class="submenu">
                  <ul class="submenu__list">
                    {
                      item.children.map((child) => (
                        <li>
                          <a
                            href={child.href}
                            class="submenu__link"
                            aria-current={path === child.href ? 'page' : undefined}
                          >
                            <span class="submenu__label">{child.label}</span>
                            {child.note && <span class="submenu__note">{child.note}</span>}
                          </a>
                        </li>
                      ))
                    }
                  </ul>
                  {
                    item.href && (
                      <a href={item.href} class="submenu__all">
                        All products
                        <Icon name="arrow-right" size={15} />
                      </a>
                    )
                  }
                </div>
              </li>
            ) : (
              <li class="nav__item">
                <a
                  href={item.href}
                  class="nav__link"
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>

      <div class="nav__actions">
        {
          site.phone && (
            <a href={`tel:${site.phone}`} class="nav__contact">
              <Icon name="phone" size={17} />
              {site.phoneDisplay ?? site.phone}
            </a>
          )
        }
        <a href="/request-a-quote/" class="btn btn--primary nav__cta">Request a Quote</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: saturate(160%) blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    min-height: 4.25rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    color: var(--plum-deep);
    flex-shrink: 0;
  }
  .brand__mark {
    color: var(--plum);
    display: grid;
    place-items: center;
  }
  .brand__name {
    font-family: var(--font-display);
    font-size: 1.28rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    font-variation-settings: 'SOFT' 0, 'WONK' 1, 'opsz' 24;
  }

  .nav-toggle {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    background: none;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    color: var(--plum-deep);
    cursor: pointer;
  }
  .nav-toggle__open,
  .nav-toggle__close {
    display: grid;
    place-items: center;
  }
  .nav-toggle__close {
    display: none;
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle__open {
    display: none;
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle__close {
    display: grid;
  }

  /* ---------- Mobile ---------- */
  .nav {
    display: none;
    position: absolute;
    inset: 4.25rem 0 auto;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
    padding: var(--sp-4) var(--sp-5) var(--sp-6);
    max-height: calc(100dvh - 4.25rem);
    overflow-y: auto;
  }
  .nav[data-open] {
    display: block;
  }
  .nav__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav__item + .nav__item {
    border-top: 1px solid var(--line);
  }
  .nav__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-2);
    width: 100%;
    padding: 0.85rem 0;
    font: inherit;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
    background: none;
    border: 0;
    text-align: left;
    cursor: pointer;
    min-height: 2.75rem;
  }
  .nav__link[aria-current='page'] {
    color: var(--plum);
    font-weight: 600;
  }
  /* :global because the class is applied to an <Icon> component's <svg>,
     which does not carry this component's scope attribute. */
  :global(.nav__chevron) {
    transition: transform 0.18s var(--ease);
    flex-shrink: 0;
  }
  [aria-expanded='true'] :global(.nav__chevron) {
    transform: rotate(180deg);
  }
  .submenu {
    display: none;
    padding-bottom: var(--sp-4);
  }
  .nav__item--has-menu [aria-expanded='true'] + .submenu {
    display: block;
  }
  .submenu__list {
    list-style: none;
    margin: 0 0 var(--sp-3);
    padding: 0;
    display: grid;
    gap: 1px;
  }
  .submenu__link {
    display: block;
    padding: 0.6rem 0.75rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--ink-soft);
  }
  .submenu__link:hover,
  .submenu__link[aria-current='page'] {
    background: var(--paper-warm);
    color: var(--plum);
  }
  .submenu__label {
    display: block;
    font-weight: 500;
    font-size: var(--step-0);
    color: var(--ink);
  }
  .submenu__link:hover .submenu__label {
    color: var(--plum);
  }
  .submenu__note {
    display: block;
    font-size: var(--step--1);
    color: var(--ink-muted);
    line-height: 1.4;
  }
  .submenu__all {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--plum);
    text-decoration: none;
    padding: 0.4rem 0.75rem;
  }
  .nav__actions {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    margin-top: var(--sp-5);
  }
  .nav__contact {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--plum);
    min-height: 2.75rem;
  }

  /* ---------- Desktop ---------- */
  @media (min-width: 62rem) {
    .nav-toggle {
      display: none;
    }
    .nav {
      display: flex;
      position: static;
      inset: auto;
      align-items: center;
      justify-content: flex-end;
      gap: var(--sp-5);
      flex: 1;
      padding: 0;
      border: 0;
      background: none;
      max-height: none;
      overflow: visible;
    }
    .nav__list {
      display: flex;
      align-items: center;
      gap: var(--sp-1);
    }
    .nav__item + .nav__item {
      border-top: 0;
    }
    .nav__item--has-menu {
      position: relative;
    }
    .nav__link {
      padding: 0.5rem 0.7rem;
      border-radius: var(--radius-sm);
      font-size: 0.96rem;
      white-space: nowrap;
      min-height: 2.25rem;
    }
    .nav__link:hover {
      color: var(--plum);
      background: var(--paper-warm);
    }
    .submenu {
      position: absolute;
      top: calc(100% + 0.4rem);
      left: 0;
      /* An invisible bridge across the gap above the panel. Without it the
         pointer leaves the menu item while moving down from the trigger and
         the submenu closes before it can be reached. */
      --submenu-gap: 0.4rem;
      width: max-content;
      max-width: min(30rem, calc(100vw - 3rem));
      background: var(--white);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: var(--sp-3);
    }
    .submenu::before {
      content: '';
      position: absolute;
      top: calc(var(--submenu-gap) * -1);
      left: 0;
      right: 0;
      height: var(--submenu-gap);
    }
    .nav__item--has-menu:last-of-type .submenu {
      left: auto;
      right: 0;
    }
    .submenu__list {
      grid-template-columns: 1fr;
      margin-bottom: var(--sp-2);
    }
    .nav__actions {
      flex-direction: row;
      align-items: center;
      gap: var(--sp-4);
      margin-top: 0;
      flex-shrink: 0;
    }
    .nav__contact {
      font-size: 0.94rem;
      white-space: nowrap;
    }
    .nav__cta {
      min-height: 2.5rem;
      padding: 0.55rem 1.05rem;
      font-size: 0.94rem;
    }
  }
  @media (min-width: 62rem) and (min-width: 78rem) {
    .submenu__list {
      grid-template-columns: 1fr 1fr;
      gap: 2px 0.5rem;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.getElementById('primary-nav');
  const submenuButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-submenu-toggle]'),
  );
  const DESKTOP = window.matchMedia('(min-width: 62rem)');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    if (open) nav?.removeAttribute('data-open');
    else nav?.setAttribute('data-open', '');
  });

  function closeAllSubmenus(except?: HTMLButtonElement) {
    for (const b of submenuButtons) {
      if (b !== except) b.setAttribute('aria-expanded', 'false');
    }
  }

  for (const button of submenuButtons) {
    button.addEventListener('click', () => {
      const open = button.getAttribute('aria-expanded') === 'true';
      closeAllSubmenus(button);
      button.setAttribute('aria-expanded', String(!open));
    });

    // On pointer devices at desktop width, hovering the group opens it.
    const item = button.closest('.nav__item--has-menu');
    let closeTimer: ReturnType<typeof setTimeout> | undefined;

    item?.addEventListener('pointerenter', (event) => {
      if (!DESKTOP.matches || (event as PointerEvent).pointerType === 'touch') return;
      clearTimeout(closeTimer);
      closeAllSubmenus(button);
      button.setAttribute('aria-expanded', 'true');
    });
    item?.addEventListener('pointerleave', () => {
      if (!DESKTOP.matches) return;
      // A short grace period, so a diagonal path toward the panel does not
      // close it the moment the pointer clips outside the item.
      clearTimeout(closeTimer);
      closeTimer = setTimeout(() => {
        button.setAttribute('aria-expanded', 'false');
      }, 180);
    });
  }

  // Escape closes an open submenu and returns focus to its trigger.
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const open = submenuButtons.find(
      (b) => b.getAttribute('aria-expanded') === 'true',
    );
    if (open) {
      open.setAttribute('aria-expanded', 'false');
      open.focus();
    }
  });

  // Clicking outside closes desktop submenus.
  document.addEventListener('click', (event) => {
    if (!DESKTOP.matches) return;
    const target = event.target as Node;
    if (!nav?.contains(target)) closeAllSubmenus();
  });

  // Focus moving out of a group closes it, so keyboard users are not trapped.
  nav?.addEventListener('focusout', (event) => {
    if (!DESKTOP.matches) return;
    const related = event.relatedTarget as Node | null;
    for (const button of submenuButtons) {
      const item = button.closest('.nav__item--has-menu');
      if (item && !item.contains(related)) button.setAttribute('aria-expanded', 'false');
    }
  });
</script>
