---
/**
 * Section wrapper for the supporting pages, so headings, spacing and rules stay
 * consistent without every page repeating the same markup and CSS.
 */
interface Props {
  id: string;
  heading: string;
  intro?: string;
  level?: 2 | 3;
}

const { id, heading, intro, level = 2 } = Astro.props;
const Tag = `h${level}` as 'h2' | 'h3';
---

<section class="info-section" id={id} aria-labelledby={`${id}-heading`}>
  <Tag id={`${id}-heading`} class="info-section__heading">{heading}</Tag>
  {intro && <p class="info-section__intro measure" set:html={intro} />}
  <slot />
</section>

<style>
  .info-section {
    padding-block: var(--sp-6);
    border-top: 1px solid var(--line);
    scroll-margin-top: 6rem;
  }
  .info-section:first-of-type {
    border-top: 0;
    padding-top: 0;
  }
  .info-section__heading {
    font-size: var(--step-2);
    margin-bottom: var(--sp-4);
  }
  .info-section__intro {
    color: var(--ink-soft);
    margin-bottom: var(--sp-5);
  }
</style>
