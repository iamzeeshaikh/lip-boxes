---
import type { Crumb } from '../lib/schema';

interface Props {
  crumbs: Crumb[];
  /** Renders light-on-dark for use over a tinted hero. */
  tone?: 'default' | 'warm';
}

const { crumbs, tone = 'default' } = Astro.props;
---

<nav class:list={['crumbs', tone === 'warm' && 'crumbs--warm']} aria-label="Breadcrumb">
  <ol class="crumbs__list">
    {
      crumbs.map((crumb, i) => (
        <li class="crumbs__item">
          {crumb.path ? (
            <a href={crumb.path}>{crumb.name}</a>
          ) : (
            <span aria-current="page">{crumb.name}</span>
          )}
          {i < crumbs.length - 1 && (
            <span class="crumbs__sep" aria-hidden="true">/</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .crumbs {
    font-size: var(--step--1);
  }
  .crumbs__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0;
    color: var(--ink-muted);
  }
  .crumbs__item {
    display: inline-flex;
    align-items: center;
  }
  .crumbs__sep {
    margin-inline: 0.5rem;
    color: var(--line-strong);
  }
  .crumbs a {
    color: var(--ink-muted);
    text-decoration-color: color-mix(in srgb, var(--ink-muted) 30%, transparent);
  }
  .crumbs a:hover {
    color: var(--plum);
  }
  .crumbs [aria-current='page'] {
    color: var(--ink);
    font-weight: 500;
  }
  .crumbs--warm .crumbs__list {
    color: color-mix(in srgb, var(--ink-soft) 90%, transparent);
  }
</style>
