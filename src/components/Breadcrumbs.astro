---
import type { Crumb } from '../lib/schema';

interface Props {
  crumbs: Crumb[];
  /** Renders light-on-dark for use over a tinted hero. */
  tone?: 'default' | 'warm';
}

const { crumbs, tone = 'default' } = Astro.props;
---

<nav class="vx-crumbs" data-tone={tone} aria-label="Breadcrumb">
  <ol class="vx-crumbs__list">
    {
      crumbs.map((crumb, i) => (
        <li class="vx-crumbs__item">
          {crumb.path ? (
            <a href={crumb.path}>{crumb.name}</a>
          ) : (
            <span aria-current="page">{crumb.name}</span>
          )}
          {i < crumbs.length - 1 && (
            <span class="vx-crumbs__sep" aria-hidden="true">/</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .vx-crumbs {
    font-size: var(--step--1);
  }
  .vx-crumbs__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0;
    color: var(--vx-mute-c);
  }
  .vx-crumbs__item {
    display: inline-flex;
    align-items: center;
  }
  .vx-crumbs__sep {
    margin-inline: 0.5rem;
    color: var(--vx-accent);
  }
  .vx-crumbs a {
    color: var(--vx-mute-c);
    text-decoration: none;
  }
  .vx-crumbs a:hover {
    color: var(--vx-accent);
  }
  .vx-crumbs [aria-current='page'] {
    color: var(--vx-ink);
    font-weight: 500;
  }
</style>
