---
import { footerNav, legalNav } from '../data/nav';
import { site, sameAs } from '../data/site';
import LogoMark from './LogoMark.astro';
import { PACK_LINE } from '../data/order';

const year = new Date().getFullYear();
---

<footer class="vx-foot">
  <div class="vx-foot__brand">
    <a href="/" class="vx-foot__logo" aria-label="Lip Boxes home">
      <LogoMark class="vx-foot__mark" />
      <span>Lip Boxes</span>
    </a>
    <p class="vx-foot__blurb">
      Custom printed packaging for lip balm, lipstick, lip gloss and lip care
      brands. Every style is {PACK_LINE}, with free shipping to the US, UK, Canada and
      Australia. Larger runs are quoted.
    </p>
    <ul class="vx-foot__contact">
      {
        site.address && (
          <li>
            {site.address.street}, {site.address.city}, {site.address.region}{' '}
            {site.address.postalCode}, USA
          </li>
        )
      }
      <li>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </li>
      {
        site.phone && (
          <li>
            <a href={`tel:${site.phone}`}>{site.phoneDisplay ?? site.phone}</a>
          </li>
        )
      }
      {
        site.whatsapp && (
          <li>
            <a
              href={`https://wa.me/${site.whatsapp.replace(/[^0-9]/g, '')}?text=${encodeURIComponent('Hi Lip Boxes! I need more info about Lip Boxes https://lipboxes.com/')}`}
              rel="noopener noreferrer"
              target="_blank"
            >
              WhatsApp
            </a>
          </li>
        )
      }
    </ul>
    <a href="/request-a-quote/" class="vx-btn vx-btn--red">Request a Quote</a>
  </div>

  <nav class="vx-foot__cols" aria-label="Footer">
    {
      footerNav.map((group) => (
        <div class="vx-foot__col">
          <h2 class="vx-foot__h">{group.heading}</h2>
          <ul>
            {group.links.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </div>
      ))
    }
  </nav>

  <div class="vx-foot__legal">
    <p>
      &copy; {year} {site.name}. Prices in US dollars. Online orders are paid by
      PayPal invoice or bank transfer after proof approval, or cash on delivery in
      the US and Canada.
    </p>
    <ul>
      {legalNav.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      <li><a href="/sitemap.xml">Sitemap</a></li>
    </ul>
    {
      sameAs.length > 0 && (
        <ul>
          {sameAs.map((url) => (
            <li>
              <a href={url} rel="me noopener noreferrer" target="_blank">
                {new URL(url).hostname.replace('www.', '')}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</footer>

<style>
  .vx-foot {
    margin-top: auto;
    background: var(--vx-ink);
    color: #d6d6d6;
    padding: 64px var(--gut) 28px;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 20px;
    font-size: 14.5px;
  }
  .vx-foot a {
    color: #d6d6d6;
    text-decoration: none;
  }
  .vx-foot a:hover {
    color: #fff;
    text-decoration: underline;
  }
  .vx-foot ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .vx-foot__brand {
    grid-column: 1 / 4;
  }
  .vx-foot__logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font: 600 26px/1 var(--vx-head);
    color: #fff !important;
    text-decoration: none !important;
  }
  .vx-foot__logo :global(.vx-foot__mark) {
    width: 36px;
    height: 36px;
    outline: 1px solid #444;
  }
  .vx-foot__blurb {
    margin: 16px 0;
    max-width: 40ch;
  }
  .vx-foot__contact {
    margin-bottom: 20px !important;
  }
  .vx-foot__contact li {
    padding: 3px 0;
  }
  .vx-foot__contact a {
    color: #fff;
  }
  .vx-foot .vx-btn {
    color: #fff;
    text-decoration: none;
  }
  .vx-foot__cols {
    grid-column: 5 / 13;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 20px;
  }
  .vx-foot__h {
    font-size: 18px;
    color: #fff;
    padding-bottom: 10px;
    margin-bottom: 10px;
    border-bottom: 1px solid #444;
  }
  .vx-foot__col a {
    display: block;
    padding: 4px 0;
    line-height: 1.35;
  }
  .vx-foot__legal {
    grid-column: 1 / -1;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px 22px;
    margin-top: 40px;
    padding-top: 18px;
    border-top: 1px solid #444;
    font-size: 13px;
    color: #9a9a9a;
  }
  .vx-foot__legal p {
    margin: 0;
  }
  .vx-foot__legal ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
  }
  .vx-foot__legal a {
    color: #bdbdbd;
  }
  @media (max-width: 1180px) {
    .vx-foot__brand,
    .vx-foot__cols {
      grid-column: 1 / -1;
    }
    .vx-foot__cols {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 28px 20px;
    }
  }
  @media (max-width: 640px) {
    .vx-foot {
      padding: 48px var(--gut) 96px;
    }
    .vx-foot__cols {
      grid-template-columns: 1fr 1fr;
      gap: 28px 16px;
    }
  }
</style>
