---
/**
 * The short quote form given its own full-width band rather than sitting as one
 * more block inside the article.
 *
 * Same component and same endpoint as the product pages — this only changes how
 * prominently it is presented and adds a supporting column that explains what
 * happens after the form is sent.
 */
import ShortQuoteForm from './ShortQuoteForm.astro';
import Icon from './Icon.astro';

interface Props {
  /** Product name written into the hidden field and the subject line. */
  product: string;
  heading: string;
  sub: string;
  /** Location name, set only on state and city pages. */
  location?: string;
  pageTitle?: string;
  /** Three short lines beside the form. Written per page, not shared. */
  points: string[];
  id?: string;
}

const {
  product,
  heading,
  sub,
  location,
  pageTitle,
  points,
  id = 'quote',
} = Astro.props;
---

<section class="vx-qband" id={id} aria-labelledby="quick-quote-heading">
  <div class="vx-frame">
    <div class="vx-qband__inner">
      <div class="vx-qband__aside">
        <p class="vx-qband__lede">{sub}</p>
        <ul class="vx-qband__points">
          {
            points.map((point) => (
              <li>
                <Icon name="check" size={17} class="vx-qband__tick" />
                <span>{point}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="vx-qband__form">
        <ShortQuoteForm
          product={product}
          location={location}
          pageTitle={pageTitle}
          heading={heading}
          sub={sub}
          id="quick-quote"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .vx-qband {
    padding-block: var(--sp-7);
    background: var(--vx-grey);
    scroll-margin-top: 4.5rem;
  }
  .vx-qband__inner {
    display: grid;
    gap: var(--sp-5);
    align-items: start;
  }
  @media (min-width: 62rem) {
    .vx-qband__inner {
      grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
      gap: var(--sp-7);
    }
    .vx-qband__aside {
      position: sticky;
      top: 5.5rem;
    }
  }
  .vx-qband__aside,
  .vx-qband__form {
    min-width: 0;
  }
  .vx-qband__lede {
    font: 500 1.5rem/1.2 var(--vx-head);
    color: var(--vx-ink);
    margin: 0 0 var(--sp-4);
    padding-top: 14px;
    border-top: 1px solid var(--vx-rule);
  }
  .vx-qband__points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--sp-3);
  }
  .vx-qband__points li {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    font-size: var(--step--1);
    color: var(--vx-ink-2);
    line-height: 1.55;
  }
  .vx-qband__points :global(.vx-qband__tick) {
    flex-shrink: 0;
    margin-top: 0.15rem;
    color: var(--vx-accent);
  }

  /* The form card carries the visual weight in this band, so it gets a
     stronger edge than it does inside an article column. */
  .vx-qband__form :global(.vx-qq) {
    background: var(--vx-white);
  }
  /* The heading and sub-line are already stated in the aside column on wide
     screens, so the card repeats them only where the aside stacks above. */
  @media (min-width: 62rem) {
    .vx-qband__form :global(.vx-qq__sub) {
      display: none;
    }
  }
</style>
