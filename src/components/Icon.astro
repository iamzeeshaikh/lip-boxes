---
/**
 * Inline SVG icons drawn on a single 24px grid with a consistent 1.5px stroke,
 * so the set reads as one family. No icon library dependency and no icon font.
 */
export type IconName =
  | 'check'
  | 'arrow-right'
  | 'layers'
  | 'sparkle'
  | 'shield'
  | 'leaf'
  | 'ruler'
  | 'palette'
  | 'droplet'
  | 'box'
  | 'mail'
  | 'phone'
  | 'clock'
  | 'truck'
  | 'file-text'
  | 'chevron-down'
  | 'menu'
  | 'close'
  | 'quote'
  | 'scissors'
  | 'upload';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;

const paths: Record<IconName, string> = {
  check: '<path d="M20 6 9 17l-5-5"/>',
  'arrow-right': '<path d="M4 12h15"/><path d="m13 6 6 6-6 6"/>',
  layers:
    '<path d="M12 3 3 8l9 5 9-5-9-5Z"/><path d="m3 14 9 5 9-5"/>',
  sparkle:
    '<path d="M12 3v4M12 17v4M4.5 12h-1.5M21 12h-1.5M6.7 6.7 5.6 5.6M18.4 18.4l-1.1-1.1M17.3 6.7l1.1-1.1M5.6 18.4l1.1-1.1"/><circle cx="12" cy="12" r="3.5"/>',
  shield:
    '<path d="M12 3 5 6v6c0 4 3 7.2 7 9 4-1.8 7-5 7-9V6l-7-3Z"/><path d="m9.2 12 2 2 3.6-3.6"/>',
  leaf: '<path d="M4 20c0-8 5-13 16-14-1 11-6 15-13 14"/><path d="M6 18c3-4 6-6.5 10-8"/>',
  ruler:
    '<rect x="2.5" y="8.5" width="19" height="7" rx="1.5"/><path d="M7 8.5v3M11 8.5v3M15 8.5v3M19 8.5v3"/>',
  palette:
    '<path d="M12 3a9 9 0 0 0 0 18c1.4 0 2-1 2-2s-.7-1.6-.7-2.4c0-1 .8-1.6 1.8-1.6H18a3 3 0 0 0 3-3c0-4.7-4-9-9-9Z"/><circle cx="8" cy="10" r="1"/><circle cx="12" cy="7.5" r="1"/><circle cx="16" cy="10" r="1"/>',
  droplet: '<path d="M12 3s6 6.2 6 10.2A6 6 0 0 1 6 13.2C6 9.2 12 3 12 3Z"/>',
  box: '<path d="M20.5 8 12 3.5 3.5 8v8L12 20.5 20.5 16V8Z"/><path d="M3.5 8 12 12.5 20.5 8M12 12.5v8"/>',
  mail:
    '<rect x="2.5" y="5" width="19" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  phone:
    '<path d="M6.5 3.5h3l1.5 4-2 1.5a11 11 0 0 0 5 5L15.5 12l4 1.5v3a2 2 0 0 1-2.2 2A15.5 15.5 0 0 1 4.5 5.7 2 2 0 0 1 6.5 3.5Z"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7.5V12l3.5 2"/>',
  truck:
    '<path d="M2.5 6.5h10v9h-10z"/><path d="M12.5 9.5h4l3 3v3h-7z"/><circle cx="6" cy="17.5" r="1.8"/><circle cx="16.5" cy="17.5" r="1.8"/>',
  'file-text':
    '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5Z"/><path d="M14 3v5h5M9 13h6M9 16.5h4"/>',
  'chevron-down': '<path d="m6 9.5 6 6 6-6"/>',
  menu: '<path d="M3.5 7h17M3.5 12h17M3.5 17h17"/>',
  close: '<path d="m6 6 12 12M18 6 6 18"/>',
  quote:
    '<path d="M9.5 6C7 7.2 5.5 9.4 5.5 12.5V18h5v-5.5h-3c0-2 .8-3.3 2.6-4.2Z"/><path d="M18 6c-2.5 1.2-4 3.4-4 6.5V18h5v-5.5h-3c0-2 .8-3.3 2.6-4.2Z"/>',
  scissors:
    '<circle cx="6" cy="6.5" r="2.5"/><circle cx="6" cy="17.5" r="2.5"/><path d="M8.2 8 20 17M8.2 16 20 7"/>',
  upload:
    '<path d="M4 15.5V19a1.5 1.5 0 0 0 1.5 1.5h13A1.5 1.5 0 0 0 20 19v-3.5"/><path d="M12 15.5V4M8 8l4-4 4 4"/>',
};
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={paths[name]}
/>
