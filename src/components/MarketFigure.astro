---
/**
 * A small piece of product photography used inside a market or guide page.
 *
 * Deliberately modest: a capped, wide-crop thumbnail that links to the product
 * page. No caption block — the alt text names the photograph for assistive
 * technology, and the surrounding copy already says what the format is.
 */
import { Image } from 'astro:assets';
import { productImage } from '../lib/images';
import type { Product } from '../data/types';

interface Props {
  product: Product;
  /** Which photograph to use. Wrapped, so an out-of-range index is safe. */
  index?: number;
  eager?: boolean;
}

const { product, index = 0, eager = false } = Astro.props;

const picture = product.images[index % product.images.length];
const source = productImage(product.slug, picture.file);
---

<a class="m-figure" href={`/${product.slug}/`}>
  <Image
    src={source}
    alt={picture.alt}
    widths={[320, 480, 640]}
    sizes="(min-width: 62rem) 26rem, (min-width: 40rem) 40vw, 88vw"
    loading={eager ? 'eager' : 'lazy'}
    decoding={eager ? 'sync' : 'async'}
    width={640}
    height={400}
    class="m-figure__img"
  />
</a>

<style>
  .m-figure {
    display: block;
    width: 100%;
    max-width: 26rem;
    min-width: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--paper-warm);
    line-height: 0;
  }
  .m-figure:hover {
    border-color: var(--plum);
  }
  .m-figure__img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    display: block;
  }
</style>
