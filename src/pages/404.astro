---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { indexableProducts } from '../data/products';

/*
 * Astro emits this as 404.html, and Vercel serves it with a genuine 404 status
 * for unmatched routes. It is noindexed and excluded from the sitemap, so it
 * cannot become a soft 404.
 */
const popular = indexableProducts.slice(0, 6);
---

<BaseLayout
  title="Page Not Found | Lip Boxes"
  description="This page could not be found. Browse the custom lip packaging product directory, the specification guides, or request a quote."
  path="/404/"
  noindex
>
  <div class="nf">
    <div class="vx-frame vx-frame--slim nf__inner">
      <p class="nf__code" aria-hidden="true">404</p>
      <h1>This page could not be found</h1>
      <p class="vx-lede nf__lead">
        The address may have changed, or the link that brought you here may be out
        of date. The routes below cover almost everything on the site.
      </p>

      <div class="vx-btns nf__actions">
        <a href="/products/" class="vx-btn vx-btn--red">
          Browse all products
          <Icon name="arrow-right" size={18} />
        </a>
        <a href="/request-a-quote/" class="vx-btn vx-btn--line">Request a Quote</a>
      </div>

      <h2 class="nf__heading">Product pages</h2>
      <ul class="nf__list">
        {popular.map((product) => <li><a href={`/${product.slug}/`}>{product.name}</a></li>)}
      </ul>

      <h2 class="nf__heading">Specification and ordering</h2>
      <ul class="nf__list">
        <li><a href="/materials/">Board and material options</a></li>
        <li><a href="/printing-options/">Printing options and methods</a></li>
        <li><a href="/finishes/">Finishing and coating options</a></li>
        <li><a href="/box-styles/">Box styles and structures</a></li>
        <li><a href="/how-to-order/">How to order</a></li>
        <li><a href="/faqs/">FAQs</a></li>
      </ul>

      <p class="nf__note">
        If you followed a link from another site and think something is broken,
        tell us on the <a href="/contact/">contact the packaging team</a> and we will look at it.
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .nf {
    padding-block: var(--sp-8) var(--sp-9);
    background: var(--vx-white);
    flex: 1;
  }
  .nf__code {
    font-family: var(--vx-head);
    font-size: clamp(6rem, 16vw, 12rem);
    font-weight: 300;
    line-height: 0.85;
    color: var(--vx-accent);
    margin-bottom: var(--sp-3);
  }
  .nf h1 {
    font-size: var(--step-4);
    margin-bottom: var(--sp-4);
  }
  .nf__lead {
    max-width: 46ch;
    margin-bottom: var(--sp-6);
  }
  .nf__actions {
    margin-bottom: var(--sp-8);
  }
  .nf__heading {
    font-family: var(--vx-head);
    font-size: 1.3rem;
    font-weight: 500;
    color: var(--vx-ink);
    padding-bottom: 8px;
    border-bottom: 1px solid var(--vx-rule);
    margin-bottom: var(--sp-3);
  }
  .nf__list {
    list-style: none;
    margin: 0 0 var(--sp-6);
    padding: 0;
    display: grid;
    gap: var(--sp-2) var(--sp-5);
    border-top: 1px solid var(--vx-rule-lt);
    padding-top: var(--sp-4);
  }
  @media (min-width: 40rem) {
    .nf__list {
      grid-template-columns: 1fr 1fr;
    }
  }
  .nf__note {
    font-size: var(--step--1);
    color: var(--vx-mute-c);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--vx-rule-lt);
  }
</style>
