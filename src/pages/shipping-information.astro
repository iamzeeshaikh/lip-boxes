---
import InfoLayout from '../layouts/InfoLayout.astro';
import InfoSection from '../components/InfoSection.astro';
import SpecTable from '../components/SpecTable.astro';
import { site } from '../data/site';
import {
  SHIPPING,
  PRODUCTION_TEXT,
  RETURNS,
  PRICE_LINE,
} from '../data/order';
---

<InfoLayout
  path="/shipping-information/"
  title="Shipping Information | Delivery and Freight"
  description="Free shipping to the US, UK, Canada and Australia. Production takes 5–7 business days; delivery 5–7 days in the US, 7–10 abroad."
  h1="Shipping Information"
  lead="Shipping is free on every order to the United States, the United Kingdom, Canada and Australia. Production takes 5–7 business days after you approve the proof, and delivery takes 5–7 business days in the US or 7–10 to the UK, Canada and Australia."
  ogTitle="How Lip Packaging Orders Are Packed and Shipped"
  ogDescription="Free shipping to the US, UK, Canada and Australia, delivery times, packing formats, case counts and pallet configurations."
  points={['Free shipping to the US, UK, Canada and Australia', `Production ${PRODUCTION_TEXT}`, 'Packed to your case count']}
  ctaHeading="Have specific receiving requirements?"
  ctaBody="Send your delivery address, any dock or appointment requirements, and your preferred case count with the inquiry so the shipment is planned correctly the first time."
>
  <InfoSection
    id="costs-and-times"
    heading="Shipping costs and delivery times"
    intro="One set of terms applies to the online 100-box pack and to every quoted run."
  >
    <div class="vx-table">
      <table>
        <caption>Shipping cost and delivery time by destination country.</caption>
        <thead>
          <tr><th scope="col">Ship to</th><th scope="col">Shipping cost</th><th scope="col">Production</th><th scope="col">Delivery after dispatch</th></tr>
        </thead>
        <tbody>
          {
            SHIPPING.destinations.map((d) => (
              <tr>
                <th scope="row">{d.name}</th>
                <td>Free</td>
                <td>{PRODUCTION_TEXT}</td>
                <td>{d.transitMin}–{d.transitMax} business days</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <ul class="vx-ul">
      <li>
        <strong>Shipping is free</strong> to the United States, the United Kingdom,
        Canada and Australia, whether you buy the online pack ({PRICE_LINE}) or a
        quoted run. There is no separate freight charge to settle afterward.
      </li>
      <li>
        <strong>Production</strong> takes {PRODUCTION_TEXT} and starts when you
        approve your proof. Every order ships with tracking.
      </li>
      <li>
        <strong>Other countries</strong> are quoted on request. Tell us the
        destination in your inquiry and we will confirm the cost before you
        commit.
      </li>
      <li>
        <strong>Import duties or taxes</strong> charged by the destination country,
        if any, are paid by the buyer.
      </li>
    </ul>
  </InfoSection>

  <InfoSection
    id="how-packaging-arrives"
    heading="How each product arrives"
    intro="Not everything ships flat, and that changes how many cases a delivery takes."
  >
    <SpecTable
      caption="How each product format is supplied and packed."
      columns={['Product', 'Supplied as', 'Packed in', 'Shipment size driven by']}
      rows={[
        ['Folding cartons', 'Flat, glued along one seam', 'Counted, banded stacks in cases', 'Weight, usually'],
        ['Hang tab cartons', 'Flat, glued', 'Cased upright so tabs are not crushed', 'Weight'],
        ['Paper tubes', 'Assembled and capped', 'Nested in counted cases', 'Volume, not weight'],
        ['Labels', 'Sheets or wound rolls', 'Boxed with core and unwind noted', 'Weight'],
        ['Rigid boxes', 'Assembled, not flat', 'Interleaved or bagged, layered in cases', 'Volume, not weight'],
        ['Counter displays', 'Flat, scored for folding', 'Cases or pallet layers', 'Volume'],
        ['Inserts', 'Flat or pre-formed', 'Separate cases, matched to carton counts', 'Weight or volume'],
      ]}
    />
    <p class="vx-note">
      Paper tubes and rigid boxes are bulky for their weight, so a delivery of
      them arrives as more cases than the same number of flat cartons. Shipping is
      still free; plan the storage space before the delivery date.
    </p>
  </InfoSection>

  <InfoSection
    id="delivery-details"
    heading="What we need to deliver smoothly"
    intro="Shipping costs you nothing to the four countries above. These details decide whether the delivery goes through the first time."
  >
    <ul class="vx-ul">
      <li><strong>The full delivery address</strong>, including whether it is a commercial address, a residential one or a distribution center.</li>
      <li><strong>Receiving requirements</strong>, such as a liftgate, an appointment, inside delivery or a booking portal.</li>
      <li><strong>A contact name and phone number</strong> the carrier can call on the day.</li>
      <li><strong>Any deadline</strong> the delivery has to meet, so we can tell you at quoting stage whether it is achievable.</li>
    </ul>
    <p class="vx-measure">
      If you would rather arrange collection with your own carrier or freight
      forwarder, that is straightforward. Tell us at quoting stage and we will
      prepare the shipment for collection instead.
    </p>
  </InfoSection>

  <InfoSection
    id="case-counts"
    heading="Case counts and pallet configuration"
    intro="How goods are packed matters more than it sounds, particularly if they are going to a filler or a retailer."
  >
    <p class="vx-measure">
      We pack to whatever case count suits your operation. If your filling line
      runs in batches of 250, cases of 250 save your team counting. If a retailer
      specifies units per case and a pallet pattern in their packaging guide, we
      pack to that specification.
    </p>
    <p class="vx-measure">
      Send the requirement with the inquiry rather than after production. Building a
      case count into the production plan costs nothing; repacking finished stock
      costs labor and risks damage. For retail programs the same applies to
      pallet height, overhang tolerance and labeling, which is covered alongside
      the structural detail on the <a href="/hang-tab-lip-balm-boxes/">peg-ready carton page</a>.
    </p>
  </InfoSection>

  <InfoSection
    id="third-party"
    heading="Delivering to a co-packer or third-party filler"
    intro="This is common and works well, provided their intake requirements reach us in advance."
  >
    <ul class="vx-ul">
      <li>Their receiving hours, and whether deliveries need a booked appointment.</li>
      <li>Their purchase order or reference number, which usually has to appear on the paperwork and often on each case.</li>
      <li>Case labelling requirements, including any barcode or SKU format they expect.</li>
      <li>Maximum pallet height and weight they can handle.</li>
      <li>Whether they need a packing list inside the consignment as well as attached to it.</li>
    </ul>
    <p class="vx-note">
      A refused delivery at a co-packer is expensive and slow to resolve. Ten
      minutes gathering their requirements before we ship avoids nearly all of it.
    </p>
  </InfoSection>

  <InfoSection
    id="damage"
    heading="Damage, shortages and what to do"
    intro="Rare, but worth knowing the process before you need it."
  >
    <ol class="vx-ol">
      <li>
        <strong>Check the consignment on arrival</strong> against the packing list,
        before the driver leaves if possible.
      </li>
      <li>
        <strong>Note any visible damage on the delivery paperwork.</strong> A
        signature without a notation makes a carrier claim considerably harder.
      </li>
      <li>
        <strong>Photograph the packaging as received</strong>, including the outer
        case and the pallet, not only the damaged goods.
      </li>
      <li>
        <strong>Contact us within {RETURNS.claimDays} days of delivery</strong> at <a href={`mailto:${site.email}`}>{site.email}</a> or <a href={`tel:${site.phone}`}>{site.phoneDisplay}</a>,
        with the photographs and your order number.
      </li>
    </ol>
    <p class="vx-measure">
      Damaged, defective or misprinted boxes reported within {RETURNS.claimDays} days
      are reprinted free or refunded, and we pay the shipping. Custom printed
      packaging is made to your approved proof and cannot be resold, so returns
      for change of mind are not available. The full rules are in our <a href={RETURNS.policyPath}>refund and return policy</a>.
    </p>
  </InfoSection>

  <InfoSection
    id="storage"
    heading="Storing packaging once it arrives"
    intro="Board and label stock both change with storage conditions, and a few precautions protect the investment."
  >
    <ul class="vx-ul">
      <li>Keep pallets off concrete floors and away from external walls, since board absorbs moisture.</li>
      <li>Store flat cartons flat and banded rather than loose, so they do not bow.</li>
      <li>Case hang tab cartons upright, so tabs are not crushed under load.</li>
      <li>Keep label rolls cool and out of sunlight; heat causes adhesive ooze at the edges.</li>
      <li>Do not stack rigid boxes deeply, because assembled boxes mark each other under pressure.</li>
      <li>Keep paper tubes cool, as they are more heat-sensitive than plastic containers.</li>
    </ul>
    <p class="vx-measure">
      If you would rather not warehouse a full run at once, a scheduled call-off
      holds the volume price while releasing stock against a delivery schedule. That
      arrangement is described on the <a href="/custom-lip-care-packaging/">bulk program page</a>.
    </p>
  </InfoSection>
</InfoLayout>
