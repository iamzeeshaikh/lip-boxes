---
import { withExtras } from '../lib/page-faqs';
import type { GetStaticPaths } from 'astro';
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ProductGallery from '../components/ProductGallery.astro';
import ShortQuoteForm from '../components/ShortQuoteForm.astro';
import ContentBlocks from '../components/ContentBlocks.astro';
import FaqList from '../components/FaqList.astro';
import ProductCard from '../components/ProductCard.astro';
import QuoteCta from '../components/QuoteCta.astro';
import DesignYourLipBox from '../components/DesignYourLipBox.astro';
import Icon from '../components/Icon.astro';
import { products, getProduct, hasReviews } from '../data/products';
import { productImage, publicImageUrl, publicSocialUrl } from '../lib/images';
import { site } from '../data/site';
import {
  graph,
  organizationSchema,
  websiteSchema,
  breadcrumbSchema,
  webPageSchema,
  productSchema,
  faqSchema,
  type Crumb,
} from '../lib/schema';
import '../styles/forms.css';

export const getStaticPaths: GetStaticPaths = () =>
  products.map((product) => ({ params: { product: product.slug } }));

const { product: slug } = Astro.params;
const product = getProduct(slug!);
if (!product) throw new Error(`Unknown product slug: ${slug}`);

const path = `/${product.slug}/`;

/*
 * Social and structured-data image URLs use the stable public copies rather
 * than Astro's hashed /_astro/ output, so they survive a redeploy unchanged.
 */
const ogIndex = product.ogImageIndex ?? 0;
const ogUrl = publicSocialUrl(product.slug, product.images[ogIndex].file);
/* Mirrors the <Picture> candidates rendered by ProductGallery. */
const lcpAsset = await getImage({
  src: productImage(product.slug, product.images[0].file),
  widths: [420, 620, 840],
  format: 'avif',
  width: 840,
  height: 840,
});

const galleryUrls = product.images.map((image) =>
  publicImageUrl(product.slug, image.file),
);

const crumbs: Crumb[] = [
  { name: 'Home', path: '/' },
  { name: 'Products', path: '/products/' },
  { name: product.name },
];

/* Rotated so fifteen product pages do not repeat the same two headings. */
const headingOffset = [...product.slug].reduce((sum, char) => sum + char.charCodeAt(0), 0);
const pickHeading = <T,>(options: T[]): T => options[headingOffset % options.length];

const formHeading = pickHeading([
  'Get a price for this box',
  'Price this specification',
  'Send your dimensions and quantity',
  'What would this cost at your volume?',
  'Ask for a written price',
]);
const relatedHeading = pickHeading([
  'Other formats brands pair with this',
  'Commonly ordered alongside',
  'What else fits the same line',
  'Formats that work with this one',
  'Often specified together',
]);

const related = product.related
  .map((relatedSlug) => getProduct(relatedSlug))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));

const contents = product.blocks.map((block) => ({
  id: block.id,
  label: block.navLabel ?? block.heading,
}));

const schema = graph(
  organizationSchema(),
  websiteSchema(),
  webPageSchema({
    path,
    name: product.h1,
    description: product.metaDescription,
    primaryImage: galleryUrls[ogIndex],
  }),
  breadcrumbSchema(crumbs),
  productSchema(product, galleryUrls),
  faqSchema(withExtras(path, product.faqs), path),
);

const showReviews = hasReviews(product.reviews);
---

<BaseLayout
  title={product.seoTitle}
  description={product.metaDescription}
  path={path}
  ogTitle={product.ogTitle}
  ogDescription={product.ogDescription}
  ogImage={ogUrl}
  ogImageAlt={product.images[ogIndex].alt}
  ogType="product"
  preloadImage={lcpAsset.src}
  preloadImageSrcset={lcpAsset.srcSet.attribute}
  preloadImageSizes="(min-width: 62rem) 46vw, 92vw"
  preloadImageType="image/avif"
  schema={[schema]}
>
  <div class="vx-ptop">
    <div class="vx-frame">
      <Breadcrumbs crumbs={crumbs} />

      <div class="vx-phero">
        <div class="vx-phero__gallery">
          <ProductGallery
            slug={product.slug}
            images={product.images}
            productName={product.name}
          />
        </div>

        <div class="vx-phero__intro">
          <h1>{product.h1}</h1>
          <p class="vx-lede vx-phero__lead">{product.valueProp}</p>

          <ul class="vx-phero__highlights">
            {
              product.highlights.map((highlight) => (
                <li>
                  <span>{highlight}</span>
                </li>
              ))
            }
          </ul>

          <div class="vx-pnote">
            <p class="vx-pnote__line" data-boilerplate>{site.startingPriceStatement}</p>
            <p class="vx-pnote__sub" data-boilerplate>
              The starting figure applies to qualifying large-volume custom
              orders. It is not a fixed price for every quantity, and your
              written quote will state the actual unit price for your job.
            </p>
          </div>

          <div class="vx-btns vx-phero__actions">
            <a href="#quick-quote" class="vx-btn vx-btn--red">
              Request a Quote
              <Icon name="arrow-right" size={18} />
            </a>
            <a href="/sample-kit/" class="vx-arrow">Request a sample</a>
          </div>

          <p class="vx-phero__contact">
            <a href={`mailto:${site.email}`}>{site.email}</a>
            {site.phone && <> &middot; <a href={`tel:${site.phone}`}>{site.phoneDisplay ?? site.phone}</a></>}
          </p>
        </div>
      </div>
    </div>
  </div>

  <DesignYourLipBox product={product} />

  <div class="vx-frame vx-pbody">
    <aside class="vx-ptoc" aria-labelledby="contents-heading">
      <h2 class="vx-ptoc__heading" id="contents-heading">On this page</h2>
      <nav aria-labelledby="contents-heading">
        <ul class="vx-ptoc__list">
          {contents.map((item) => <li><a href={`#${item.id}`}>{item.label}</a></li>)}
          <li><a href="#specification">Specification</a></li>
          <li><a href="#faqs">Questions</a></li>
        </ul>
      </nav>
    </aside>

    <div class="vx-pmain">
      <div class="vx-pquote">
        <ShortQuoteForm product={product.name} heading={formHeading} />
      </div>

      <ContentBlocks blocks={product.blocks} slug={product.slug} />

      <section class="block" id="specification" aria-labelledby="specification-heading">
        <h2 class="block__h" id="specification-heading">
          {product.name} specification
        </h2>
        <p class="block__intro vx-measure" data-boilerplate>
          A summary of what can be specified on this product. Anything marked as
          quoted or made to order is confirmed in writing before production.
        </p>
        <div class="vx-table">
          <table>
            <caption>Specification summary for {product.name.toLowerCase()}.</caption>
            <tbody>
              {
                product.specs.map((spec) => (
                  <tr>
                    <th scope="row">{spec.label}</th>
                    <td>{spec.value}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </section>

      {
        showReviews && (
          <section class="block" id="reviews" aria-labelledby="reviews-heading">
            <h2 class="block__h" id="reviews-heading">Customer reviews</h2>
            <p class="reviews__summary">
              <strong>{product.reviews!.ratingValue}</strong> out of
              {' '}{product.reviews!.bestRating ?? 5} from
              {' '}{product.reviews!.reviewCount} reviews
            </p>
            <ul class="reviews">
              {
                product.reviews!.reviews.map((review) => (
                  <li class="review">
                    <p class="review__rating">
                      {review.ratingValue} / {product.reviews!.bestRating ?? 5}
                    </p>
                    <blockquote class="review__body"><p>{review.body}</p></blockquote>
                    <p class="review__meta">
                      {review.author} &middot;{' '}
                      <time datetime={review.datePublished}>
                        {new Date(review.datePublished).toLocaleDateString('en-US', {
                          year: 'numeric',
                          month: 'long',
                        })}
                      </time>
                    </p>
                  </li>
                ))
              }
            </ul>
          </section>
        )
      }

      <section class="block" id="faqs" aria-labelledby="faqs-heading">
        <h2 class="block__h" id="faqs-heading">
          {product.name}: common questions
        </h2>
        <p class="block__intro vx-measure" data-boilerplate>
          Answers to the questions we are asked most often about this product.
          If yours is not here, put it in the inquiry form and we will answer it
          directly.
        </p>
        <FaqList faqs={withExtras(path, product.faqs)} level={3} />
      </section>
    </div>
  </div>

  {
    related.length > 0 && (
      <section class="vx-band" aria-labelledby="related-heading">
        <div class="vx-frame">
          <div class="vx-sechead">
            <h2 id="related-heading">{relatedHeading}</h2>
            <p class="related__intro" data-boilerplate>
              Each of these is quoted from the same inquiry, so a range can be
              produced on one specification and one schedule.
            </p>
          </div>
          <div class="vx-tiles vx-tiles--range">
            {related.map((item) => <ProductCard product={item} compact />)}
          </div>
        </div>
      </section>
    )
  }

  <QuoteCta
    product={product.name}
    heading={`Get a written price for ${product.name.toLowerCase()}`}
    body="Send your dimensions, quantity and artwork status. You will get a written quote with the price at your quantity and at the next volume break, plus anything we need clarified."
  />
</BaseLayout>

<style>
  .vx-ptop {
    padding: 22px 0 56px;
  }
  .vx-phero {
    display: grid;
    gap: var(--sp-6);
    margin-top: 26px;
  }
  @media (min-width: 62rem) {
    .vx-phero {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 20px;
      align-items: start;
    }
    .vx-phero__gallery {
      grid-column: 1 / 7;
    }
    .vx-phero__intro {
      grid-column: 7 / 13;
      position: sticky;
      top: 100px;
    }
  }
  .vx-phero__gallery,
  .vx-phero__intro {
    min-width: 0;
  }
  .vx-phero h1 {
    font-size: clamp(2.5rem, 1.4rem + 3.2vw, 4.6rem);
    line-height: 0.95;
    margin-bottom: 20px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--vx-rule);
  }
  .vx-phero__lead {
    margin-bottom: var(--sp-5);
    max-width: 52ch;
  }
  .vx-phero__highlights {
    list-style: none;
    margin: 0 0 var(--sp-5);
    padding: 0;
    border-top: 1px solid var(--vx-rule-lt);
  }
  .vx-phero__highlights li {
    padding: 10px 0 10px 24px;
    position: relative;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--vx-ink-2);
    border-bottom: 1px solid var(--vx-rule-lt);
  }
  .vx-phero__highlights li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.15em;
    width: 12px;
    height: 2px;
    background: var(--vx-accent);
  }

  .vx-pnote {
    border-left: 3px solid var(--vx-accent);
    padding: 4px 0 4px 16px;
    margin-bottom: var(--sp-5);
  }
  .vx-pnote__line {
    font-weight: 600;
    margin: 0 0 var(--sp-2);
    line-height: 1.5;
  }
  .vx-pnote__sub {
    font-size: 0.875rem;
    color: var(--vx-mute-c);
    margin: 0;
    line-height: 1.55;
  }

  .vx-phero__actions {
    margin-bottom: var(--sp-4);
  }
  .vx-phero__contact {
    font-size: 0.875rem;
    color: var(--vx-mute-c);
    margin: 0;
  }

  /* --- Body --- */
  .vx-pbody {
    display: grid;
    gap: var(--sp-6);
    padding-block: var(--sp-8) var(--sp-7);
  }
  @media (min-width: 68rem) {
    .vx-pbody {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 20px;
      align-items: start;
    }
    .vx-ptoc {
      grid-column: 1 / 4;
    }
    .vx-pmain {
      grid-column: 4 / 13;
    }
  }

  .vx-ptoc {
    display: none;
  }
  @media (min-width: 68rem) {
    .vx-ptoc {
      display: block;
      position: sticky;
      top: 100px;
      padding-right: 40px;
    }
  }
  .vx-ptoc__heading {
    font-size: 1.5rem;
    padding-bottom: 10px;
    margin-bottom: 4px;
    border-bottom: 1px solid var(--vx-rule);
  }
  .vx-ptoc__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .vx-ptoc__list a {
    display: block;
    padding: 8px 0;
    font-size: 0.94rem;
    color: var(--vx-ink-2);
    text-decoration: none;
    border-bottom: 1px solid var(--vx-rule-lt);
    line-height: 1.4;
  }
  .vx-ptoc__list a:hover {
    color: var(--vx-accent);
  }

  .vx-pquote {
    margin-bottom: var(--sp-7);
    scroll-margin-top: 6rem;
  }

  .vx-pmain .block {
    padding-block: var(--sp-6);
    border-top: 1px solid var(--vx-rule);
    scroll-margin-top: 6rem;
  }
  .block__h {
    font-size: var(--step-3);
    margin-bottom: var(--sp-4);
  }
  .block__intro {
    color: var(--vx-ink-2);
    margin-bottom: var(--sp-5);
  }

  /* --- Reviews (rendered only when real review data exists) --- */
  .reviews__summary {
    font-size: var(--step-1);
    margin-bottom: var(--sp-4);
  }
  .reviews {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--sp-4);
  }
  .review {
    border-top: 1px solid var(--vx-rule);
    padding: var(--sp-4) 0 0;
  }
  .review__rating {
    font-weight: 600;
    color: var(--vx-accent);
    margin-bottom: var(--sp-2);
  }
  .review__body {
    margin: 0 0 var(--sp-2);
  }
  .review__meta {
    font-size: var(--step--1);
    color: var(--vx-mute-c);
    margin: 0;
  }
</style>
