---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import ContentBlocks from '../../../components/ContentBlocks.astro';
import FaqList from '../../../components/FaqList.astro';
import ProductCard from '../../../components/ProductCard.astro';
import MarketFigure from '../../../components/MarketFigure.astro';
import QuoteBand from '../../../components/QuoteBand.astro';
import Icon from '../../../components/Icon.astro';
import { cities, getCity, getState, siblingCities, locationUrl } from '../../../data/locations';
import { getProduct } from '../../../data/products';
import { site } from '../../../data/site';
import {
  graph,
  organizationSchema,
  websiteSchema,
  webPageSchema,
  breadcrumbSchema,
  faqSchema,
  type Crumb,
} from '../../../lib/schema';

export const getStaticPaths: GetStaticPaths = () =>
  cities.map((city) => ({ params: { city: city.slug } }));

const { city: slug } = Astro.params;
const location = getCity(slug!);
if (!location) throw new Error(`Unknown city slug: ${slug}`);

const path = `/locations/cities/${location.slug}/`;
const parent = location.parentState ? getState(location.parentState) : undefined;

const crumbs: Crumb[] = [
  { name: 'Home', path: '/' },
  { name: 'Locations', path: '/locations/' },
  { name: 'Cities', path: '/locations/cities/' },
  { name: location.name },
];

const siblings = siblingCities(location);
const related = location.related
  .map((productSlug) => getProduct(productSlug))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));

/*
 * WebPage, not LocalBusiness. There is no premises, no local staff and no
 * local phone number in this city, so a LocalBusiness node would assert
 * something untrue. FAQPage covers the questions block.
 */
const schema = graph(
  organizationSchema(),
  websiteSchema(),
  webPageSchema({
    path,
    name: location.h1,
    description: location.metaDescription,
  }),
  breadcrumbSchema(crumbs),
  faqSchema(location.faqs, path),
);

/*
 * City pages take a different photograph from their parent state page. The
 * offset is seeded from the slug and shifted by one so a city and its state
 * never open with the same image even when they recommend the same product.
 */
const offset = [...location.slug].reduce((sum, char) => sum + char.charCodeAt(0), 1);

/* Rotated for the same reason as the state pages: identical headings across
   twenty pages read as generated copy rather than written copy. */
const pick = <T,>(options: T[]): T => options[offset % options.length];

const faqHeading = pick([
  `Questions from ${location.name} brands`,
  `${location.name}: what people ask`,
  `Answered before you order for ${location.name}`,
  `Common ${location.name} queries`,
]);
const productsHeading = pick([
  `Packaging for ${location.name} brands`,
  `Formats that fit this ${location.name} pattern`,
  `What works in this channel`,
  `Suited to the ${location.name} brief above`,
]);
const quoteHeading = pick([
  `Get a price delivered to ${location.name}`,
  `Price this for ${location.name}`,
  `Send a ${location.name} specification`,
  `What does this cost in ${location.name}?`,
]);
const nextHeading = pick([
  'Where to go next',
  'Related market guides',
  'Read around this market',
  'Wider context for this page',
]);
const leadFigure = related[0];
---

<BaseLayout
  title={location.seoTitle}
  description={location.metaDescription}
  path={path}
  ogTitle={location.ogTitle}
  ogDescription={location.ogDescription}
  schema={[schema]}
>
  <PageHero
    eyebrow={`${location.name}, ${location.stateCode}`}
    h1={location.h1}
    lead={location.deck}
    crumbs={crumbs}
    points={[location.marketAngle, 'Made to order', 'Shipped nationwide']}
  />

  <div class="city-lead">
    <div class="wrap">
      <div class="city-lead__row">
        {leadFigure && <MarketFigure product={leadFigure} index={offset} eager />}
        <div class="city-lead__aside">
          <p class="city-lead__angle">{location.cardDescription}</p>
          <a class="btn btn--primary" href="#quote">
            {`Get a price for ${location.name}`}
            <Icon name="arrow-right" size={18} />
          </a>
          <p class="city-lead__note" data-boilerplate>
            Four fields. A written price, or the questions we need answered first.
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="wrap city-body">
    <article class="city-article">
      {
        parent && (
          <p class="city-parent">
            This page covers one thing: {location.marketAngle.toLowerCase()}. For the
            wider view, read{' '}
            <a href={locationUrl(parent)}>
              {`how ${parent.name} buys, and where ${location.name} differs`}
            </a>.
          </p>
        )
      }

      <ContentBlocks blocks={location.sections} slug={location.related[0]} />

      <section class="city-section" id="faqs" aria-labelledby="city-faqs-heading">
        <h2 class="city-section__heading" id="city-faqs-heading">{faqHeading}</h2>
        <FaqList faqs={location.faqs} level={3} />
      </section>

      <p class="city-note">
        {site.name} has no address, warehouse, collection point or staff in{' '}
        {location.name}. Packaging is manufactured to order and shipped to{' '}
        {location.name} addresses through a nationwide carrier service, with delivery
        cost and lead time confirmed in writing on each quote.
      </p>
    </article>
  </div>

  <QuoteBand
    product={related[0]?.name ?? 'Custom Lip Balm Boxes'}
    location={location.name}
    pageTitle={location.seoTitle}
    heading={quoteHeading}
    sub={`Send your quantity and dimensions and you will get a written price with delivery to your ${location.name} address costed in.`}
    points={[
      `Specified around ${location.marketAngle.toLowerCase()}, the pattern this page covers`,
      'A written unit price at your quantity and at the next volume break',
      'Delivery costed to the address you give us, not estimated',
    ]}
  />

  {
    related.length > 0 && (
      <section class="section" aria-labelledby="city-products-heading">
        <div class="wrap">
          <span class="eyebrow">Formats that fit this market</span>
          <h2 id="city-products-heading">{productsHeading}</h2>
          <div class="grid grid--products city-products">
            {related.map((product) => <ProductCard product={product} compact />)}
          </div>
        </div>
      </section>
    )
  }

  <section class="section section--warm" aria-labelledby="city-nearby-heading">
    <div class="wrap">
      <h2 id="city-nearby-heading">{nextHeading}</h2>
      <div class="city-next">
        {
          parent && (
            <a class="city-next__card" href={locationUrl(parent)}>
              <span class="city-next__label">State overview</span>
              <span class="city-next__title">{parent.name}</span>
              <span class="city-next__text">{parent.marketAngle}</span>
            </a>
          )
        }
        {
          siblings.map((sibling) => (
            <a class="city-next__card" href={locationUrl(sibling)}>
              <span class="city-next__label">Nearby city</span>
              <span class="city-next__title">{sibling.name}</span>
              <span class="city-next__text">{sibling.marketAngle}</span>
            </a>
          ))
        }
        <a class="city-next__card" href="/locations/cities/">
          <span class="city-next__label">Directory</span>
          <span class="city-next__title">All city pages</span>
          <span class="city-next__text">Twenty US markets, each written around one buying pattern</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .city-lead {
    background: var(--paper-warm);
    padding-bottom: var(--sp-7);
  }
  .city-lead__row {
    display: grid;
    gap: var(--sp-5);
    align-items: center;
  }
  @media (min-width: 48rem) {
    .city-lead__row {
      grid-template-columns: minmax(0, 26rem) minmax(0, 1fr);
      gap: var(--sp-6);
    }
  }
  .city-lead__aside {
    min-width: 0;
  }
  .city-lead__angle {
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink);
    margin-bottom: var(--sp-4);
    text-wrap: balance;
  }
  .city-lead__note {
    margin: var(--sp-3) 0 0;
    font-size: var(--step--1);
    color: var(--ink-muted);
  }
  .city-body {
    padding-block: var(--sp-7);
  }
  .city-article {
    max-width: 46rem;
    margin-inline: auto;
    min-width: 0;
  }
  .city-parent {
    padding: var(--sp-3) var(--sp-4);
    background: var(--paper-warm);
    border-left: 3px solid var(--rose);
    border-radius: var(--radius-sm);
    font-size: var(--step--1);
    color: var(--ink-soft);
    margin-bottom: var(--sp-5);
  }
  .city-section {
    padding-block: var(--sp-6);
    border-top: 1px solid var(--line);
    scroll-margin-top: 6rem;
  }
  .city-section__heading {
    font-size: var(--step-2);
    margin-bottom: var(--sp-4);
  }
  .city-note {
    margin-top: var(--sp-6);
    padding: var(--sp-4);
    background: var(--paper-warm);
    border-radius: var(--radius-sm);
    font-size: var(--step--1);
    color: var(--ink-soft);
    line-height: 1.6;
  }
  .city-products {
    margin-top: var(--sp-5);
  }
  .city-next {
    display: grid;
    gap: var(--sp-3);
    margin-top: var(--sp-5);
  }
  @media (min-width: 40rem) {
    .city-next {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 62rem) {
    .city-next {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .city-next__card {
    display: block;
    min-width: 0;
    padding: var(--sp-4);
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color 0.18s var(--ease);
  }
  .city-next__card:hover {
    border-color: var(--plum);
  }
  .city-next__label {
    display: block;
    font-size: 0.7rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: 0.3rem;
  }
  .city-next__title {
    display: block;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 0.2rem;
  }
  .city-next__card:hover .city-next__title {
    color: var(--plum);
  }
  .city-next__text {
    display: block;
    font-size: var(--step--1);
    color: var(--ink-muted);
    line-height: 1.5;
  }
</style>
