---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import ContentBlocks from '../../../components/ContentBlocks.astro';
import FaqList from '../../../components/FaqList.astro';
import ProductCard from '../../../components/ProductCard.astro';
import ShortQuoteForm from '../../../components/ShortQuoteForm.astro';
import { cities, getCity, getState, siblingCities, locationUrl } from '../../../data/locations';
import { getProduct } from '../../../data/products';
import { site } from '../../../data/site';
import {
  graph,
  organizationSchema,
  websiteSchema,
  webPageSchema,
  breadcrumbSchema,
  faqSchema,
  type Crumb,
} from '../../../lib/schema';

export const getStaticPaths: GetStaticPaths = () =>
  cities.map((city) => ({ params: { city: city.slug } }));

const { city: slug } = Astro.params;
const location = getCity(slug!);
if (!location) throw new Error(`Unknown city slug: ${slug}`);

const path = `/locations/cities/${location.slug}/`;
const parent = location.parentState ? getState(location.parentState) : undefined;

const crumbs: Crumb[] = [
  { name: 'Home', path: '/' },
  { name: 'Locations', path: '/locations/' },
  { name: 'Cities', path: '/locations/cities/' },
  { name: location.name },
];

const siblings = siblingCities(location);
const related = location.related
  .map((productSlug) => getProduct(productSlug))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));

/*
 * WebPage, not LocalBusiness. There is no premises, no local staff and no
 * local phone number in this city, so a LocalBusiness node would assert
 * something untrue. FAQPage covers the questions block.
 */
const schema = graph(
  organizationSchema(),
  websiteSchema(),
  webPageSchema({
    path,
    name: location.h1,
    description: location.metaDescription,
  }),
  breadcrumbSchema(crumbs),
  faqSchema(location.faqs, path),
);
---

<BaseLayout
  title={location.seoTitle}
  description={location.metaDescription}
  path={path}
  ogTitle={location.ogTitle}
  ogDescription={location.ogDescription}
  schema={[schema]}
>
  <PageHero
    eyebrow={`${location.name}, ${location.stateCode}`}
    h1={location.h1}
    lead={location.deck}
    crumbs={crumbs}
    points={[location.marketAngle, 'Made to order', 'Shipped nationwide']}
  />

  <div class="wrap city-body">
    <article class="city-article">
      {
        parent && (
          <p class="city-parent">
            This page covers one thing: {location.marketAngle.toLowerCase()}. For the
            wider view, read{' '}
            <a href={locationUrl(parent)}>
              {`how ${parent.name} buys, and where ${location.name} differs`}
            </a>.
          </p>
        )
      }

      <ContentBlocks blocks={location.sections} slug={location.related[0]} />

      <section class="city-section" id="faqs" aria-labelledby="city-faqs-heading">
        <h2 class="city-section__heading" id="city-faqs-heading">
          Questions from {location.name} brands
        </h2>
        <FaqList faqs={location.faqs} level={3} />
      </section>

      <p class="city-note">
        {site.name} has no address, warehouse, collection point or staff in{' '}
        {location.name}. Packaging is manufactured to order and shipped to{' '}
        {location.name} addresses through a nationwide carrier service, with delivery
        cost and lead time confirmed in writing on each quote.
      </p>
    </article>
  </div>

  <section class="section section--warm" aria-labelledby="city-quote-heading">
    <div class="wrap wrap--narrow">
      <ShortQuoteForm
        product={related[0]?.name ?? 'Custom Lip Balm Boxes'}
        location={location.name}
        pageTitle={location.seoTitle}
        id="quick-quote"
        heading={`Get a price delivered to ${location.name}`}
        sub={`Four fields. Send your quantity and dimensions and you will get a written price with delivery to your ${location.name} address costed in.`}
      />
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="section" aria-labelledby="city-products-heading">
        <div class="wrap">
          <span class="eyebrow">Formats that fit this market</span>
          <h2 id="city-products-heading">Packaging for {location.name} brands</h2>
          <div class="grid grid--products city-products">
            {related.map((product) => <ProductCard product={product} compact />)}
          </div>
        </div>
      </section>
    )
  }

  <section class="section section--warm" aria-labelledby="city-nearby-heading">
    <div class="wrap">
      <h2 id="city-nearby-heading">Where to go next</h2>
      <div class="city-next">
        {
          parent && (
            <a class="city-next__card" href={locationUrl(parent)}>
              <span class="city-next__label">State overview</span>
              <span class="city-next__title">{parent.name}</span>
              <span class="city-next__text">{parent.marketAngle}</span>
            </a>
          )
        }
        {
          siblings.map((sibling) => (
            <a class="city-next__card" href={locationUrl(sibling)}>
              <span class="city-next__label">Nearby city</span>
              <span class="city-next__title">{sibling.name}</span>
              <span class="city-next__text">{sibling.marketAngle}</span>
            </a>
          ))
        }
        <a class="city-next__card" href="/locations/cities/">
          <span class="city-next__label">Directory</span>
          <span class="city-next__title">All city pages</span>
          <span class="city-next__text">Twenty US markets, each written around one buying pattern</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .city-body {
    padding-block: var(--sp-7);
  }
  .city-article {
    max-width: 46rem;
    margin-inline: auto;
    min-width: 0;
  }
  .city-parent {
    padding: var(--sp-3) var(--sp-4);
    background: var(--paper-warm);
    border-left: 3px solid var(--rose);
    border-radius: var(--radius-sm);
    font-size: var(--step--1);
    color: var(--ink-soft);
    margin-bottom: var(--sp-5);
  }
  .city-section {
    padding-block: var(--sp-6);
    border-top: 1px solid var(--line);
    scroll-margin-top: 6rem;
  }
  .city-section__heading {
    font-size: var(--step-2);
    margin-bottom: var(--sp-4);
  }
  .city-note {
    margin-top: var(--sp-6);
    padding: var(--sp-4);
    background: var(--paper-warm);
    border-radius: var(--radius-sm);
    font-size: var(--step--1);
    color: var(--ink-soft);
    line-height: 1.6;
  }
  .city-products {
    margin-top: var(--sp-5);
  }
  .city-next {
    display: grid;
    gap: var(--sp-3);
    margin-top: var(--sp-5);
  }
  @media (min-width: 40rem) {
    .city-next {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 62rem) {
    .city-next {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .city-next__card {
    display: block;
    min-width: 0;
    padding: var(--sp-4);
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color 0.18s var(--ease);
  }
  .city-next__card:hover {
    border-color: var(--plum);
  }
  .city-next__label {
    display: block;
    font-size: 0.7rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: 0.3rem;
  }
  .city-next__title {
    display: block;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 0.2rem;
  }
  .city-next__card:hover .city-next__title {
    color: var(--plum);
  }
  .city-next__text {
    display: block;
    font-size: var(--step--1);
    color: var(--ink-muted);
    line-height: 1.5;
  }
</style>
