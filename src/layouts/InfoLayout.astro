---
import FaqList from '../components/FaqList.astro';
import { newExtras, extraHeading } from '../lib/page-faqs';
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import QuoteCta from '../components/QuoteCta.astro';
import {
  graph,
  organizationSchema,
  websiteSchema,
  webPageSchema,
  breadcrumbSchema,
  faqSchema,
  type Crumb,
} from '../lib/schema';
import type { Faq } from '../data/types';

interface Props {
  path: string;
  title: string;
  description: string;
  h1: string;
  lead: string;
  points?: string[];
  ogTitle?: string;
  ogDescription?: string;
  /** Page type for schema. */
  pageType?: 'WebPage' | 'AboutPage' | 'ContactPage' | 'CollectionPage';
  /** Rendered visibly by the caller; supplied here so FAQPage schema matches. */
  faqs?: Faq[];
  ctaHeading?: string;
  ctaBody?: string;
  /** Overrides the secondary CTA target, so a page never links to itself. */
  ctaSecondaryHref?: string;
  ctaSecondaryLabel?: string;
  /** Extra schema nodes appended to the graph. */
  extraSchema?: unknown[];
  narrow?: boolean;
}

const {
  path,
  title,
  description,
  h1,
  lead,
  points,
  ogTitle,
  ogDescription,
  pageType = 'WebPage',
  faqs,
  ctaHeading,
  ctaBody,
  ctaSecondaryHref,
  ctaSecondaryLabel,
  extraSchema = [],
  narrow = false,
} = Astro.props;

const crumbs: Crumb[] = [{ name: 'Home', path: '/' }, { name: h1 }];
// questions written for this route that the page does not already show
const extraFaqList = newExtras(path, faqs ?? []);
const schemaFaqs = [...(faqs ?? []), ...extraFaqList];

const schema = graph(
  organizationSchema(),
  websiteSchema(),
  webPageSchema({ path, name: h1, description, type: pageType }),
  breadcrumbSchema(crumbs),
  ...(schemaFaqs.length > 0 ? [faqSchema(schemaFaqs, path)] : []),
  ...extraSchema,
);
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  schema={[schema]}
>
  <PageHero h1={h1} lead={lead} crumbs={crumbs} points={points} />

  <div class="vx-band">
    <div class:list={['vx-frame', narrow && 'vx-frame--slim']}>
      <slot />
    </div>
  </div>

  {extraFaqList.length > 0 && (
    <div class="vx-band vx-band--grey">
      <div class="vx-frame">
        <FaqList faqs={extraFaqList} heading={extraHeading(path)} level={3} split />
      </div>
    </div>
  )}

  <QuoteCta
    heading={ctaHeading}
    body={ctaBody}
    secondaryHref={ctaSecondaryHref}
    secondaryLabel={ctaSecondaryLabel}
  />
</BaseLayout>
