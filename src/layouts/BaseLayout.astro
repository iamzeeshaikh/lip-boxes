---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  path: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article' | 'product';
  noindex?: boolean;
  preloadImage?: string;
  preloadImageSrcset?: string;
  preloadImageSizes?: string;
  preloadImageType?: string;
  publishedTime?: string;
  modifiedTime?: string;
  /** JSON-LD objects rendered into the head. */
  schema?: unknown[];
}

const { schema = [], ...seo } = Astro.props;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <Seo {...seo} />
    <!-- Google Analytics 4. The external tag is inline-exempt; the config runs
         from a bundled script because this site's CSP has no 'unsafe-inline'. -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-8NDZWF2DDD"></script>
    <script>
      const w = window as unknown as { dataLayer: unknown[]; gtag?: (...args: unknown[]) => void };
      w.dataLayer = w.dataLayer || [];
      /* gtag.js reads the arguments object back out of the queue, so it is
         pushed verbatim; the cast only gives it a call signature. */
      const gtag = function () {
        w.dataLayer.push(arguments);
      } as (...args: unknown[]) => void;
      /* Exposed globally so /ga4-events.js can send the conversion events. */
      w.gtag = gtag;
      gtag('js', new Date());
      gtag('config', 'G-8NDZWF2DDD');
    </script>
    <script is:inline defer src="/ga4-events.js"></script>
    {
      schema.map((graph) => (
        <script type="application/ld+json" set:html={JSON.stringify(graph)} is:inline />
      ))
    }
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to main content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
    {/* ZeeOps live chat. Loaded last and deferred so it never blocks render;
        its origin is allow-listed in the CSP in vercel.json. Conversations land
        in the dashboard at chat.zeeops.dev under the `lipboxes` site. */}
    <script src="https://chat.zeeops.dev/widget.js?siteId=lipboxes" defer is:inline></script>
  </body>
</html>
